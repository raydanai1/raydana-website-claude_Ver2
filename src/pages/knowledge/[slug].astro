---
// Knowledge base article (fa) — served at /knowledge/<slug>/ for every published fa.md
import type { GetStaticPaths } from 'astro';
import ArticlePage from '../../components/knowledge/ArticlePage.astro';
import { getKnowledgeItems, type KnowledgeItem } from '../../data/knowledge';

export const getStaticPaths = (async () => {
  const items = await getKnowledgeItems('fa');
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}) satisfies GetStaticPaths;

const { item } = Astro.props as { item: KnowledgeItem };
---

<ArticlePage locale="fa" item={item} />
