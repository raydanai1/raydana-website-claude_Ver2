---
// ERP subsystem page (fa), e.g. /products/finance/general-accounting/.
import SubsystemPage from '../../../components/modules/SubsystemPage.astro';
import { modules, type Module, type Subsystem } from '../../../data/modules';

export function getStaticPaths() {
  return modules.flatMap((module) =>
    module.subsystems.map((subsystem) => ({ params: { module: module.id, subsystem: subsystem.id }, props: { module, subsystem } })),
  );
}
const { module, subsystem } = Astro.props as { module: Module; subsystem: Subsystem };
---

<SubsystemPage locale="fa" module={module} subsystem={subsystem} />
