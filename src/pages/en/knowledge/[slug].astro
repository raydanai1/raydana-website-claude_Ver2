---
// Knowledge base article (en) — served at /en/knowledge/<slug>/ for every published en.md
import type { GetStaticPaths } from 'astro';
import ArticlePage from '../../../components/knowledge/ArticlePage.astro';
import { getKnowledgeItems, type KnowledgeItem } from '../../../data/knowledge';

export const getStaticPaths = (async () => {
  const items = await getKnowledgeItems('en');
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}) satisfies GetStaticPaths;

const { item } = Astro.props as { item: KnowledgeItem };
---

<ArticlePage locale="en" item={item} />
