---
import { Image } from 'astro:assets';
import { getKnowledgeItems, knowledgeBase, type KnowledgeItem } from '../data/knowledge';
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// The three newest knowledge base items: the newest in the large middle tile, then start and end tiles.
const [newest, second, third] = await getKnowledgeItems(locale);
type Card = { item: KnowledgeItem; size: 'sm' | 'lg' };
const columns = [
  { card: second && ({ item: second, size: 'sm' } as Card), tileAfter: true },
  { card: newest && ({ item: newest, size: 'lg' } as Card) },
  { card: third && ({ item: third, size: 'sm' } as Card), tileBefore: true },
].filter((col) => col.card);
---

{
  columns.length > 0 && (
    <section id="knowledge" class="container-x scroll-mt-28 pt-12 lg:pt-[17px]" aria-labelledby="knowledge-title">
      <h2 id="knowledge-title" class="section-title text-center">
        <a href={knowledgeBase(locale)} class="hover:text-primary">{t.knowledge.title}</a>
      </h2>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:mt-6 lg:grid-cols-[347fr_527fr_347fr] lg:gap-[17px]">
        {columns.map(({ card, tileBefore, tileAfter }) => (
          <div class:list={['flex flex-col gap-[17px]', card!.size === 'lg' && 'sm:col-span-2 sm:row-start-1 lg:col-span-1 lg:row-start-auto']}>
            {tileBefore && <div class="hidden h-[161px] w-[162px] self-start rounded-[27px] bg-light-4 lg:block" aria-hidden="true" />}
            <a
              href={card!.item.href}
              class:list={[
                'group relative block overflow-hidden rounded-3xl',
                card!.size === 'lg' ? 'aspect-square lg:aspect-[527/526]' : 'aspect-[347/348]',
              ]}
            >
              <Image
                src={card!.item.data.cover}
                alt=""
                widths={card!.size === 'lg' ? [527, 1054] : [347, 694]}
                sizes={card!.size === 'lg' ? '(min-width: 1024px) 527px, 100vw' : '(min-width: 1024px) 347px, 50vw'}
                loading="lazy"
                class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
              />
              <div
                class:list={[
                  'absolute inset-x-0 bottom-0 bg-gradient-to-b from-[rgba(13,6,45,0)] to-[#0d062d]',
                  card!.size === 'lg' ? 'h-[40%] to-[82%]' : 'h-[45%]',
                ]}
              />
              <div class="absolute inset-x-0 bottom-0 px-5 pb-5 text-light">
                <h3 class="line-clamp-2 text-15 font-bold leading-8">{card!.item.data.title}</h3>
                <p class="truncate text-[13px] leading-8 lg:text-15">{card!.item.data.summary}</p>
              </div>
            </a>
            {tileAfter && <div class="hidden h-[161px] w-[162px] self-end rounded-[27px] bg-light-4 lg:block" aria-hidden="true" />}
          </div>
        ))}
      </div>
    </section>
  )
}
