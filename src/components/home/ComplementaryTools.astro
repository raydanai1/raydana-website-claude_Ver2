---
/**
 * "CYBER ERP complementary tools" (Figma 2067:3910 "mokamel"): hexagon orbit around an ERP badge
 * (2:26955, rebuilt in HTML so every label is text) next to a two-column tool list (2:28445).
 * Mobile: the orbit becomes a 3×2 grid of tappable hexagons with the tool names.
 */
import { orbitHexes, tools } from '../../data/home';
import { pagePath, type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const names = t.tools.items as Record<string, string>;
const href = pagePath('products', locale);
const toolHexes = orbitHexes.filter((h) => 'label' in h);
const img = (p: string) => `/images/home/tools/${p}`;
---

<section class="relative isolate overflow-hidden pb-12 pt-12 lg:h-[667px] lg:pb-0 lg:pt-[65px]" aria-labelledby="tools-title">
  <!-- Background Gradient2 (2:23256): soft colour wash. -->
  <img
    src={img('bg-gradient.webp')}
    alt=""
    width="870"
    height="388"
    loading="lazy"
    class="absolute inset-x-0 -top-[22%] -z-10 hidden h-[642px] w-full object-cover lg:block rtl:left-[3.96%] ltr:-scale-x-100"
  />

  <div class="container-x">
    <div class="mx-auto max-w-[1048px] text-center">
      <h2 id="tools-title" class="section-title lg:leading-[45px]" dir="auto">{t.tools.title}</h2>
      <p class="section-lead mx-auto max-w-[609px] lg:leading-[27px]">{t.tools.lead}</p>
      <p class="mt-2 text-15 leading-8 text-body lg:mt-0">{t.tools.body}</p>
    </div>

    <!-- Mobile/tablet: 3×2 hexagon grid -->
    <ul class="mx-auto mt-8 grid max-w-[520px] grid-cols-3 gap-x-3 gap-y-5 lg:hidden">
      {
        tools.map((tool) => {
          const hex = toolHexes.find((h) => h.key === tool.key)!;
          return (
            <li>
              <a href={href} class="flex min-h-11 flex-col items-center gap-2 text-center">
                <span class="relative flex size-[72px] items-center justify-center">
                  <img src={hex.src} alt="" class="absolute inset-0 size-full" />
                  <span class="relative font-['Inter',sans-serif] text-[15px] font-extrabold text-white" dir="ltr">{hex.label}</span>
                </span>
                <span class="text-[14px] font-bold leading-[1.5] text-title">{names[tool.key]}</span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- Desktop: list + orbit (2194:3968) -->
    <div class="mt-[32px] hidden items-center justify-center gap-[78px] py-[17px] lg:flex">
      <ul class="grid w-[700px] shrink-0 grid-cols-2 gap-x-3 gap-y-3">
        {
          tools.map((tool, i) => (
            <li
              class:list={[
                'h-[120px] rounded-[17px] border-[1.2px] border-white/60 px-[12px] py-[14.5px] backdrop-blur-[18.8px]',
                i === 1 ? 'bg-white/36' : 'bg-white/16',
              ]}
            >
              <a
                href={href}
                class="group flex h-full items-center gap-[12px] rounded-[10px] bg-white pe-[15px] ps-[15px] shadow-[0_6px_13px_rgba(182,201,205,0.28)] transition hover:shadow-header"
              >
                <span class="relative h-[79px] w-[54px] shrink-0">
                  <img src={tool.icon} alt="" width="54" height="79" class="absolute inset-0 size-full" />
                  <span
                    class:list={['absolute inset-0 flex items-center justify-center font-bold text-primary-dark', 'small' in tool && tool.small ? 'text-[14px]' : 'text-[20px]']}
                    dir="ltr"
                  >
                    {tool.badge}
                  </span>
                </span>
                <span class="flex-1 text-15 font-bold leading-8 text-title">{names[tool.key]}</span>
                <span class="icon-btn group-hover:bg-primary/10" aria-hidden="true">
                  <img src={img('arrow-small.svg')} alt="" width="18" height="18" class="dir-icon-rev" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="relative h-[400px] w-[393px] shrink-0" role="img" aria-label={`${t.tools.orbitTitle} ${t.tools.orbitErp}: ${tools.map((tl) => names[tl.key]).join('، ')}`} dir="ltr">
        <img src={img('ring-1.svg')} alt="" class="absolute left-[21.79px] top-[34.87px] size-[345.84px]" />
        <img src={img('ring-2.svg')} alt="" class="absolute left-[73.74px] top-[86.82px] size-[241.95px]" />
        <img src={img('ring-3.svg')} alt="" class="absolute left-[123.55px] top-[136.63px] size-[142.32px]" />
        <p class="absolute left-[134.94px] top-[178px] w-[117.42px] text-center text-[16px] font-bold leading-[1.35] text-[#4b4871]" dir="auto">{t.tools.orbitTitle}</p>
        <p class="absolute left-[166.1px] top-[205px] w-[56.93px] text-center font-bold text-[28.68px] leading-[1.35] text-[#0d2481]">{t.tools.orbitErp}</p>
        <img src={img('dot-yellow-1.webp')} alt="" class="absolute left-[90.29px] top-[105.05px] size-[40.92px]" />
        <img src={img('dot-yellow-2.webp')} alt="" class="absolute left-[242.84px] top-[216.07px] size-[40.2px]" />
        {
          orbitHexes.map((h) => {
            const [x, y, size] = h.box;
            return (
              <span class="absolute flex items-center justify-center" style={`left:${x}px;top:${y}px;width:${size}px;height:${size}px`}>
                <span class="relative shrink-0" style={`width:${h.hex}px;height:${h.hex}px;transform:rotate(${h.rotate}deg)`}>
                  <img src={h.src} alt="" class="absolute" style={`inset:${h.inset[0]}% ${h.inset[1]}%;width:${100 - 2 * h.inset[1]}%;height:${100 - 2 * h.inset[0]}%`} />
                </span>
                {'label' in h && (
                  <span
                    class="absolute font-['Inter',sans-serif] font-extrabold leading-[1.35] text-white"
                    style={`font-size:${h.labelSize}px;transform:rotate(${h.labelRotate}deg)`}
                  >
                    {h.label}
                  </span>
                )}
              </span>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
