---
/**
 * "CYBER ERP business solutions" (Figma 2067:3908, 1440×650): software screenshots under a navy gradient,
 * nine module cards in a 3×3 grid (desktop) or a swipeable row (mobile).
 */
import SwipeDots from './SwipeDots.astro';
import { modules } from '../../data/home';
import { modulePage } from '../../data/modules';
import { pagePath, type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const items = t.business.items as Record<string, string>;
---

<section class="relative isolate mt-14 overflow-hidden lg:mt-[49px] lg:h-[650px]" aria-labelledby="business-title">
  <!-- Software screenshots (2067:3906) + gradient (2:27924, opacity 90%). -->
  <img
    src="/images/home/modules/screens.webp"
    alt=""
    width="1331"
    height="1208"
    loading="lazy"
    class="absolute -z-20 hidden w-[665px] mix-blend-multiply lg:top-[109px] lg:block rtl:lg:left-[64px] ltr:lg:right-[64px] ltr:-scale-x-100"
  />
  <div class="business-gradient absolute inset-0 -z-10 opacity-90"></div>

  <div class="container-x py-10 lg:py-[44px]">
    <div class="text-center">
      <h2 id="business-title" class="text-[20px] font-bold leading-[1.5] text-white lg:text-title-2 lg:leading-[45px]" dir="auto">{t.business.title}</h2>
      <p class="mt-1 text-15 font-bold leading-relaxed text-light lg:mt-0 lg:text-title-3 lg:leading-[39px]">{t.business.lead}</p>
    </div>

    <div class="mt-6 lg:me-auto lg:ms-[20px] lg:mt-[26px] lg:w-[801px]" data-swipe>
      <ul
        class="-mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 px-4 pb-2 [scrollbar-width:none] sm:-mx-6 sm:px-6 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-x-[21px] lg:gap-y-[18.5px] lg:overflow-visible lg:p-0"
        data-swipe-track
      >
        {
          modules.map((m) => (
            <li class="glass w-[78%] max-w-[300px] shrink-0 snap-start rounded-[17px] border-[1.2px] border-white/60 bg-white/16 p-[10.5px] backdrop-blur-[18.8px] sm:w-[46%] lg:h-[120px] lg:w-auto lg:max-w-none">
              <a
                href={pagePath(modulePage(m.module), locale)}
                class="flex h-full min-h-[98px] items-center justify-between gap-2 rounded-xl bg-white ps-4 pe-3 drop-shadow-[0_25px_41.6px_rgba(154,167,193,0.25)] transition duration-300 hover:-translate-y-1.5 lg:ps-[14px] lg:pe-[13px]"
              >
                <span class="min-w-0">
                  <span class="block text-15 font-bold leading-8 text-title lg:whitespace-nowrap">{items[m.key]}</span>
                  <span class="block text-[14px] font-medium leading-[17px] text-muted lg:text-[13px]">{t.business.subsystems}</span>
                </span>
                {'glyph' in m ? (
                  <span class="relative size-[57px] shrink-0">
                    <img src={m.icon} alt="" class="absolute inset-[2.14%_6.7%] h-[95.7%] w-[86.6%]" />
                    <img src={m.glyph} alt="" class="absolute left-[17.5px] top-[15px] size-[23.7px] -scale-x-100" />
                  </span>
                ) : (
                  <img src={m.icon} alt="" width="57" height="57" class="size-[57px] shrink-0" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
      <SwipeDots count={modules.length} hint={t.a11y.swipe} class="lg:hidden" dark />
    </div>
  </div>
</section>

<style>
  .business-gradient {
    background-image: linear-gradient(-89.97deg, rgb(5, 30, 85) 0%, rgba(18, 60, 154, 0.38) 65.55%);
  }
  :global([dir='ltr']) .business-gradient {
    background-image: linear-gradient(89.97deg, rgb(5, 30, 85) 0%, rgba(18, 60, 154, 0.38) 65.55%);
  }
  @media (max-width: 1023px) {
    .business-gradient,
    :global([dir='ltr']) .business-gradient {
      background-image: linear-gradient(160deg, rgb(5, 30, 85) 0%, rgb(18, 60, 154) 100%);
    }
  }
</style>
