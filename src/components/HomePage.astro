---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import TrustedBy from './TrustedBy.astro';
import Challenges from './Challenges.astro';
import Transformation from './Transformation.astro';
import Deployment from './Deployment.astro';
import BusinessSolutions from './BusinessSolutions.astro';
import ComplementaryTools from './ComplementaryTools.astro';
import CtaStrip from './CtaStrip.astro';
import Demo from './Demo.astro';
import IndustrySolutions from './IndustrySolutions.astro';
import ImplementationProcess from './ImplementationProcess.astro';
import Customers from './Customers.astro';
import Testimonials from './Testimonials.astro';
import KnowledgeBase from './KnowledgeBase.astro';
import Footer from './Footer.astro';
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale}>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <TrustedBy locale={locale} />
    <Challenges locale={locale} />
    <Transformation locale={locale} />
    <Deployment locale={locale} />
    <BusinessSolutions locale={locale} />
    <ComplementaryTools locale={locale} />
    <CtaStrip locale={locale} text={t.ctaStrip.text} />
    <Demo locale={locale} />
    <IndustrySolutions locale={locale} />
    <CtaStrip locale={locale} variant="banner" text={t.banner.text} class="mt-14 lg:mt-20" />
    <ImplementationProcess locale={locale} />
    <Customers locale={locale} />
    <Testimonials locale={locale} />
    <KnowledgeBase locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
