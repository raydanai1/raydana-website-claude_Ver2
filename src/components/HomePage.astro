---
/**
 * Homepage — Figma file esbwi68Qf1BhHNaNeK6vhV, frame "HomePage" (2:19786), in fa / en / ru / ar.
 * Section components live in src/components/home/.
 */
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './home/Hero.astro';
import TrustedBy from './home/TrustedBy.astro';
import Challenges from './home/Challenges.astro';
import Transformation from './home/Transformation.astro';
import Deployment from './home/Deployment.astro';
import BusinessSolutions from './home/BusinessSolutions.astro';
import ComplementaryTools from './home/ComplementaryTools.astro';
import CtaStrip from './home/CtaStrip.astro';
import IndustrySolutions from './home/IndustrySolutions.astro';
import ImplementationProcess from './home/ImplementationProcess.astro';
import Customers from './home/Customers.astro';
import KnowledgeBase from './home/KnowledgeBase.astro';
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
// Calligraphic logo captions (Persian / Arabic only) need a small subset of the Nastaliq font.
const nastaliqText = locale === 'fa' || locale === 'ar' ? Object.values(t.logos).join('') : undefined;
---

<Layout locale={locale} nastaliqText={nastaliqText}>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <TrustedBy locale={locale} />
    <Challenges locale={locale} />
    <Transformation locale={locale} />
    <Deployment locale={locale} />
    <BusinessSolutions locale={locale} />
    <ComplementaryTools locale={locale} />
    <CtaStrip locale={locale} text={t.ctaStrip.text} class="mt-4 lg:mt-[50px]" />
    <IndustrySolutions locale={locale} />
    <CtaStrip locale={locale} variant="banner" text={t.banner.text} class="mt-12 lg:mt-[56px]" />
    <ImplementationProcess locale={locale} />
    <Customers locale={locale} />
    <KnowledgeBase locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
