---
import { trustedLogos } from '../data/home';
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="container-x relative z-10 mt-8 lg:-mt-8" aria-labelledby="trusted-title">
  <div class="overflow-hidden rounded-[20px] border border-stroke-strong bg-light px-4 py-6 shadow-card lg:px-12 lg:pb-12 lg:pt-8">
    <h2 id="trusted-title" class="text-center text-[15px] font-bold text-title lg:text-title-3">
      <span class="text-primary-dark" dir="ltr">{t.trusted.brand}</span>{" "}
      {t.trusted.title}
    </h2>

    <div class="marquee mt-6 lg:mt-9" data-marquee>
      <ul class="marquee-track flex w-max items-center gap-8 lg:gap-10">
        {
          [...trustedLogos, ...trustedLogos].map((logo, i) => (
            <li class="shrink-0" aria-hidden={i >= trustedLogos.length ? 'true' : undefined}>
              <img
                src={logo.src}
                alt={i >= trustedLogos.length ? '' : t.logos[logo.key]}
                width="96"
                height="96"
                loading="lazy"
                class="size-20 object-contain lg:size-24"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .marquee {
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .marquee-track {
    animation: marquee 40s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  :global([dir='rtl']) .marquee-track {
    animation-name: marquee-rtl;
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 1.25rem));
    }
  }
  @keyframes marquee-rtl {
    to {
      transform: translateX(calc(50% + 1.25rem));
    }
  }
  @media (min-width: 1024px) {
    @keyframes marquee {
      to {
        transform: translateX(calc(-50% - 2rem));
      }
    }
    @keyframes marquee-rtl {
      to {
        transform: translateX(calc(50% + 2rem));
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
    .marquee-track > li[aria-hidden] {
      display: none;
    }
  }
</style>
