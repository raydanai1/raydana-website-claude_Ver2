---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import ModuleHero from './ModuleHero.astro';
import SubsystemsBand from './SubsystemsBand.astro';
import ModuleBenefits from './ModuleBenefits.astro';
import CloudFeatures from '../cloud/CloudFeatures.astro';
import DemoRequestForm from '../cloud/DemoRequestForm.astro';
import Faq from '../cloud/Faq.astro';
import { demoOverlay, moduleImages, modulePage, type Module } from '../../data/modules';
import { cloudImages } from '../../data/cloud';
import { fill, type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
  module: Module;
}
const { locale, module } = Astro.props;
const t = useTranslations(locale).modules;
const text = module[locale];
const N = text.name;
const tabs = (module.features ?? []).map((f, i) => ({ key: String(i + 1), label: f[locale].tab, items: f[locale].items }));
const faq = (module.faq ?? []).map((f) => f[locale]);
---

<!-- Figma «detail-product-modules» (2:15565). -->
<Layout locale={locale} page={modulePage(module.id)} title={fill(t.metaTitle, { N })} description={text.tagline}>
  <Header locale={locale} page={modulePage(module.id)} />
  <main id="main">
    <ModuleHero locale={locale} tagline={text.tagline} description={text.description} illustration={moduleImages.heroHexes}>
      {fill(t.titles.hero, { N })}
    </ModuleHero>
    {module.subsystems.length > 0 && <SubsystemsBand locale={locale} module={module} />}
    <ModuleBenefits locale={locale} title={fill(t.titles.benefits, { N })} items={text.benefits} picture="chart" />
    {
      tabs.length > 0 && (
        <CloudFeatures
          locale={locale}
          id="module"
          title={fill(t.titles.features, { N })}
          tabs={tabs}
          dotEnd={cloudImages.dotStart}
          columns="md:grid-cols-2"
          listWidth="max-w-[1133px]"
          spacing="pb-14 pt-12 lg:pb-[82px] lg:pt-[65px]"
        />
      )
    }
    <!-- Figma 2:15572 + 2:15573: glass-cube photo under a blue radial gradient at 40%. -->
    <DemoRequestForm
      locale={locale}
      photo={moduleImages.demoPhoto}
      hex={moduleImages.demoHex}
      hexIcon={moduleImages.demoHexIcon}
      overlay={demoOverlay}
      height="lg:min-h-[616px]"
    />
    {faq.length > 0 && <Faq locale={locale} items={faq} spacing="pb-14 pt-14 lg:pb-[150px] lg:pt-[60px]" />}
  </main>
  <Footer locale={locale} />
</Layout>

