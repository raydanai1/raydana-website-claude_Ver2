---
import Button from '../ui/Button.astro';
import { pagePath, type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
  tagline: string;
  description: string;
  /** Hexagon cluster picture (Figma «LONEZANBORI 1»). */
  illustration: string;
  /**
   * Module hero (Figma ver4 4005:4185): items 20px apart, buttons centred under the text.
   * Subsystem hero (4005:4434): items 14px apart, buttons at the start edge.
   */
  variant?: 'module' | 'subsystem';
}
const { locale, tagline, description, illustration, variant = 'module' } = Astro.props;
const t = useTranslations(locale).modules;
const contact = pagePath('contact', locale);
const isModule = variant === 'module';
---

<!-- Figma ver4: 2:15575 / 119:5594 (background); 4005:4185 / 4005:4436 (text column + picture side by side). -->
<!-- Phones and tablets: text first, full-width buttons, then a smaller picture. -->
<section class="relative -mt-[84px] overflow-hidden bg-light lg:-mt-[118px]" aria-labelledby="module-hero-title">
  <div class="container-x relative flex flex-col pb-10 pt-[112px] lg:min-h-[582px] lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:pb-0 lg:pt-[124px] xl:gap-0 xl:px-[9px]">
    <div class:list={['relative z-10 flex w-full flex-col lg:max-w-[626px] lg:shrink-0 lg:py-8 xl:w-[626px]', isModule ? 'gap-3 lg:gap-5 xl:px-4' : 'gap-3 lg:gap-[14px] xl:px-[18px]']}>
      <!-- Title row: the subsystem page puts its hexagon icon before the title. -->
      <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-[9px]">
        <slot name="icon" />
        <h1 id="module-hero-title" class="text-[20px] font-bold leading-normal text-title text-balance sm:text-[22px] lg:text-title-2">
          <slot />
        </h1>
      </div>
      <p class="text-[16px] font-bold leading-normal text-primary lg:text-title-3">{tagline}</p>
      <p class="text-[14px] leading-8 text-body lg:text-15 rtl:lg:text-justify">{description}</p>
      <div class:list={['mt-3 flex flex-wrap gap-[10px] lg:mt-0', isModule ? 'justify-center' : 'justify-start']}>
        <Button href={contact} class="w-full sm:w-auto">{t.consult}</Button>
        <Button href={contact} variant="outline" class="w-full sm:w-auto">{t.demo}</Button>
      </div>
    </div>

    <img
      src={illustration}
      alt=""
      width="663"
      height="456"
      fetchpriority="high"
      class="mx-auto mt-6 h-auto w-full max-w-[260px] sm:max-w-[420px] lg:mx-0 lg:mt-0 lg:w-[420px] lg:max-w-none lg:shrink xl:w-[663px]"
    />
  </div>
</section>
