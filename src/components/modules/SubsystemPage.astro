---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import ModuleHero from './ModuleHero.astro';
import SubsystemIcon from './SubsystemIcon.astro';
import Architecture from './Architecture.astro';
import ProcessBand from './ProcessBand.astro';
import ModuleBenefits from './ModuleBenefits.astro';
import CloudFeatures from '../cloud/CloudFeatures.astro';
import DemoRequestForm from '../cloud/DemoRequestForm.astro';
import Faq from '../cloud/Faq.astro';
import { demoOverlay, moduleImages, modulePage, subsystemPage, type Module, type Subsystem } from '../../data/modules';
import { cloudImages } from '../../data/cloud';
import { fill, type Locale, useTranslations } from '../../i18n';
import { breadcrumbList } from '../../seo';

interface Props {
  locale: Locale;
  module: Module;
  subsystem: Subsystem;
}
const { locale, module, subsystem } = Astro.props;
const t = useTranslations(locale).modules;
const text = subsystem[locale];
const N = module[locale].name;
const S = text.name;
const page = subsystemPage(module.id, subsystem.id);
// "Procurement – Procurement" would repeat the name: use the module title pattern when the names match.
const metaTitle = S === N || S.includes(N) ? fill(t.metaTitle, { N: S }) : fill(t.subsystemMetaTitle, { S, N });
const breadcrumb = breadcrumbList(locale, [
  [useTranslations(locale).nav.products, 'products'],
  [N, modulePage(module.id)],
  [S, page],
]);
// Feature tabs: explicit data, otherwise one tab per process step that has details (Figma 119:5583 tab row).
const tabs = subsystem.features?.length
  ? subsystem.features.map((f, i) => ({ key: String(i + 1), label: f[locale].tab, items: f[locale].items }))
  : (subsystem.process ?? [])
      .map((step, i) => ({ key: String(i + 1), label: step[locale].title, items: step[locale].details.map((d) => d.replace(/^- /, '')) }))
      .filter((tab) => tab.items.length > 0);
const faq = subsystem.faq?.length
  ? subsystem.faq.map((f) => f[locale])
  : (t.subsystemFaq as { q: string; a: string }[]).map((f) => ({ q: fill(f.q, { S, N }), a: fill(f.a, { S, N }) }));
const hasArchitecture = Boolean(subsystem.architecture?.length || subsystem.stakeholders?.length);
---

<!-- Figma «detail-product-modules-subsystems» (119:5583). -->
<Layout locale={locale} page={page} title={metaTitle} description={text.description} jsonLd={[breadcrumb]}>
  <Header locale={locale} page={page} />
  <main id="main">
    <ModuleHero locale={locale} tagline={text.tagline} description={text.description} illustration={moduleImages.heroHexesSubsystem}>
      <SubsystemIcon slot="icon" id={subsystem.id} order={subsystem.order} size={68.8} />
      <span>{S}</span>
      <span class="block text-[16px] font-medium text-body sm:ms-2 sm:inline sm:text-[length:inherit] sm:font-bold sm:text-title lg:ms-[9px]">{N}</span>
    </ModuleHero>
    {hasArchitecture && <Architecture locale={locale} subsystem={subsystem} />}
    {subsystem.process?.length ? <ProcessBand locale={locale} subsystem={subsystem} /> : null}
    <ModuleBenefits locale={locale} title={fill(t.titles.subsystemBenefits, { S })} items={text.benefits} picture="calculator" />
    {
      tabs.length > 0 && (
        <CloudFeatures
          locale={locale}
          id="subsystem"
          title={fill(t.titles.subsystemFeatures, { S })}
          tabs={tabs}
          dotEnd={cloudImages.dotStart}
          columns="md:grid-cols-2"
          listWidth="max-w-[1133px]"
          spacing="pb-14 pt-12 lg:pb-[82px] lg:pt-[65px]"
        />
      )
    }
    <!-- Figma 2:15572 + 2:15573: glass-cube photo under a blue radial gradient at 40%. -->
    <DemoRequestForm
      locale={locale}
      photo={moduleImages.demoPhoto}
      hex={moduleImages.demoHex}
      hexIcon={moduleImages.demoHexIcon}
      overlay={demoOverlay}
      height="lg:min-h-[616px]"
    />
    {faq.length > 0 && <Faq locale={locale} title={t.faqTitle} items={faq} spacing="pb-14 pt-14 lg:pb-[70px] lg:pt-[60px]" />}
  </main>
  <Footer locale={locale} />
</Layout>
