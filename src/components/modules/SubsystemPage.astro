---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import ModuleHero from './ModuleHero.astro';
import SubsystemIcon from './SubsystemIcon.astro';
import Architecture from './Architecture.astro';
import ProcessBand from './ProcessBand.astro';
import ModuleBenefits from './ModuleBenefits.astro';
import ModuleDemo from './ModuleDemo.astro';
import { moduleImages, modulePage, subsystemPage, type Module, type Subsystem } from '../../data/modules';
import { fill, type Locale, useTranslations } from '../../i18n';
import { breadcrumbList } from '../../seo';

interface Props {
  locale: Locale;
  module: Module;
  subsystem: Subsystem;
}
const { locale, module, subsystem } = Astro.props;
const t = useTranslations(locale).modules;
const text = subsystem[locale];
const N = module[locale].name;
const S = text.name;
const page = subsystemPage(module.id, subsystem.id);
// "Procurement – Procurement" would repeat the name: use the module title pattern when the names match.
const metaTitle = S === N || S.includes(N) ? fill(t.metaTitle, { N: S }) : fill(t.subsystemMetaTitle, { S, N });
const breadcrumb = breadcrumbList(locale, [
  [useTranslations(locale).nav.products, 'products'],
  [N, modulePage(module.id)],
  [S, page],
]);
// Hero title «S - N» (Figma ver4 119:9350); one name when the subsystem shares the module's name.
const hasArchitecture = Boolean(subsystem.architecture?.length || subsystem.stakeholders?.length);
---

<!-- Figma «detail-product-modules-subsystems» (119:5583, ver4: «S - N» title, no feature tabs or FAQ). -->
<Layout locale={locale} page={page} title={metaTitle} description={text.description} jsonLd={[breadcrumb]}>
  <Header locale={locale} page={page} />
  <main id="main">
    <ModuleHero locale={locale} tagline={text.tagline} description={text.description} illustration={moduleImages.heroHexesSubsystem} variant="subsystem">
      <SubsystemIcon slot="icon" id={subsystem.id} order={subsystem.order} size={68.8} />
      {S === N ? S : `${S} - ${N}`}
    </ModuleHero>
    {hasArchitecture && <Architecture locale={locale} subsystem={subsystem} />}
    {subsystem.process?.length ? <ProcessBand locale={locale} subsystem={subsystem} /> : null}
    <ModuleBenefits locale={locale} title={fill(t.titles.subsystemBenefits, { S })} items={text.benefits} picture="calculator" />
    <ModuleDemo locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
