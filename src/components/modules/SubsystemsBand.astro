---
import SubsystemIcon from './SubsystemIcon.astro';
import { moduleImages, subsystemPage, type Module } from '../../data/modules';
import { fill, pagePath, type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
  module: Module;
}
const { locale, module } = Astro.props;
const t = useTranslations(locale).modules;
const name = module[locale].name;
---

<!-- Figma 2:15567 (photo) + 2:15568 (navy gradient at 86%), 2:19266 (title), 2:19265 (cards, 4 per row). -->
<section class="relative isolate overflow-hidden" aria-labelledby="subsystems-title">
  <img src={moduleImages.bandPhoto} alt="" width="1664" height="678" loading="lazy" class="absolute inset-0 -z-20 size-full object-cover" />
  <div class="band-gradient absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-x pb-12 pt-10 lg:min-h-[660px] lg:pb-[45px] lg:pt-[49px]">
    <h2 id="subsystems-title" class="text-center text-[20px] font-bold leading-normal text-[#fafafa] lg:text-title-2">
      {fill(t.titles.subsystems, { N: name })}
    </h2>

    <ul class="mx-auto mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-[35px] lg:grid-cols-4 lg:gap-x-6 lg:gap-y-[33px] xl:grid-cols-[repeat(4,260px)] xl:justify-center xl:gap-x-[32px]">
      {
        module.subsystems.map((s) => {
          const text = s[locale];
          return (
            <li>
              <a
                href={pagePath(subsystemPage(module.id, s.id), locale)}
                class="subsystem-card group relative flex h-full min-h-[200px] flex-col rounded-2xl border-[0.856px] border-stroke bg-[#fafafa] pb-[19px] ps-[22px] pe-[15px] pt-[9px] transition duration-200 hover:-translate-y-1 lg:min-h-[231px]"
                aria-label={fill(t.openSubsystem, { S: text.name })}
              >
                <span class="-ms-[15px] flex items-center gap-1">
                  <SubsystemIcon id={s.id} order={s.order} size={73.8} />
                  <span class="text-15 font-bold leading-8 text-title">{text.name}</span>
                </span>
                <span class="mt-2 mb-4 text-[14px] leading-6 text-muted">{text.cardText}</span>
                <span class="icon-btn mt-auto self-end transition-colors group-hover:bg-primary/10" aria-hidden="true">
                  <img src={moduleImages.cardArrow} alt="" width="18" height="18" class="dir-icon-rev size-[18px]" />
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* Figma 2:15568: 226° navy gradient at 86% over the photo; mirrored for LTR. */
  .band-gradient {
    background-image: linear-gradient(225.71deg, rgba(48, 80, 101, 0.86) 6.79%, rgba(25, 49, 82, 0.86) 93.94%);
  }
  :global([dir='ltr']) .band-gradient {
    background-image: linear-gradient(134.29deg, rgba(48, 80, 101, 0.86) 6.79%, rgba(25, 49, 82, 0.86) 93.94%);
  }
  /* Figma 2:19340: card shadow. */
  .subsystem-card {
    box-shadow: 0 8px 16px 0 rgba(215, 219, 240, 0.5);
  }
  .subsystem-card:hover {
    box-shadow: 0 14px 28px 0 rgba(17, 54, 85, 0.45);
  }
</style>
