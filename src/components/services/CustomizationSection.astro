---
import SectionHeading from './SectionHeading.astro';
import QuoteButton from './QuoteButton.astro';
import Hexagon from './Hexagon.astro';
import { customizationBenefits, customizationSteps, serviceImages, serviceSections } from '../../data/services';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = useTranslations(locale).services.customization;
---

<!--
  Figma ver4 4001:4148: text card 2:15059 (648 wide, end side) and "diagram-right" 4001:4147
  (612 wide, rebuilt in HTML). Phones: card first (photo on top), then the steps on one numbered line.
-->
<section id={serviceSections.customization} class="scroll-mt-28 py-8 lg:pb-[103px] lg:pt-[50px]" aria-labelledby="customization-title">
  <div class="container-x grid gap-8 lg:grid-cols-[612fr_648fr] lg:gap-[56px]">
    <!-- Card: end side on desktop, first on mobile. -->
    <div class="flex flex-col rounded-[18px] bg-white px-5 pb-6 pt-6 shadow-soft sm:px-8 lg:order-2 lg:mt-[18px] lg:self-start lg:px-[42px] lg:pb-[47px] lg:pt-[40px]">
      <SectionHeading id="customization-title">{c.title}</SectionHeading>
      <p class="mt-4 text-[14px] leading-7 text-body lg:mt-5 lg:text-justify lg:text-15 lg:leading-8">{c.intro}</p>
      <img
        src={serviceImages.customization}
        alt={c.imageAlt}
        width="740"
        height="494"
        loading="lazy"
        class="order-first -mx-5 -mt-6 mb-5 aspect-[16/10] max-w-none rounded-[18px] object-cover sm:-mx-8 lg:order-none lg:mx-0 lg:mb-0 lg:mt-6 lg:aspect-[564/241] lg:w-full lg:max-w-full lg:rounded-[15px]"
      />
      <h3 class="mt-6 text-[15px] font-bold leading-6 text-dark lg:mt-8 lg:text-[16px]">{c.benefitsTitle}</h3>
      <ul class="mt-3 list-disc space-y-1 ps-5 text-[14px] font-bold leading-6 text-ink lg:mt-4 lg:space-y-0.5 lg:ps-[21px]">
        {customizationBenefits.map((key) => <li class="ps-1">{c.benefits[key]}</li>)}
      </ul>
      <p class="mt-6 text-[14px] font-medium leading-7 text-ink lg:mt-[51px] lg:text-15">{c.integration}</p>
      <QuoteButton class="mt-6 lg:mt-[58px] lg:min-h-[88px] lg:!text-[16px] lg:!leading-6">{c.summary}</QuoteButton>
    </div>

    <!-- Process flow, desktop: tilted labels on a centred line (Figma diagram-right). -->
    <div class="relative mx-auto hidden w-full max-w-[612px] flex-col items-center lg:order-1 lg:flex">
      <div class="absolute bottom-24 top-8 left-1/2 w-px bg-[#c3c6d4]" aria-hidden="true"></div>

      <div class="relative mt-5 flex min-h-[65px] w-[355px] max-w-full items-center justify-center rounded-[11px] border border-[#c3c6d4] bg-white px-6 pt-1">
        <Hexagon color="#f90087" class="absolute -top-[21px] left-1/2 h-[37px] w-[35px] -translate-x-1/2" />
        <h3 class="text-center text-15 font-bold leading-8 text-title">{c.flowTitle}</h3>
      </div>

      <ol class="relative mt-[59px] flex w-full flex-col items-center gap-[54px]">
        {
          customizationSteps.map((step, i) => (
            <li class="flex w-full flex-col items-center">
              <div class="tilt-wrap w-fit max-w-[calc(100%-24px)]">
                <span class="tilt-back" aria-hidden="true" />
                {i === 0 && <Hexagon color="#7350ff" class="absolute -top-[48px] left-1/2 h-[51px] w-[47px] -translate-x-1/2" />}
                <h4 class="tilt-card flex min-h-[66px] items-center gap-3 px-4 py-2 text-[14px] leading-6 text-body">
                  {step.icon && <img src={step.icon} alt="" width="40" height="40" class="size-10 shrink-0" />}
                  <span>{c.steps[step.key].title}</span>
                </h4>
              </div>
              <div class="relative mt-[14px] w-full max-w-[584px] rounded-[11px] border border-[#c3c6d4] bg-white px-[21px] pb-3 pt-[17px]">
                <Hexagon color="#00bf6f" class="absolute -top-[9px] left-1/2 h-[17px] w-4 -translate-x-1/2" />
                <p class="text-[14px] leading-6 text-body">{c.steps[step.key].text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Process flow, phones/tablets: one vertical line with numbered dots. -->
    <div class="lg:hidden">
      <h3 class="flex items-center gap-2 text-[15px] font-bold leading-7 text-title">
        <Hexagon color="#f90087" class="h-[22px] w-[21px] shrink-0" />
        {c.flowTitle}
      </h3>
      <ol class="relative mt-4 space-y-3">
        <span class="absolute bottom-6 start-[15px] top-6 w-0.5 bg-[#c3c6d4]" aria-hidden="true"></span>
        {
          customizationSteps.map((step, i) => (
            <li class="relative grid grid-cols-[32px_1fr] items-start gap-3">
              <span class="relative mt-3 flex size-8 items-center justify-center rounded-full bg-[#3968ff] text-[14px] font-bold text-white ring-4 ring-light">
                {i + 1}
              </span>
              <div class="rounded-[14px] border border-[#dbe1ff] bg-white px-4 py-3">
                <h4 class="flex items-center gap-2 text-[15px] font-bold leading-6 text-title">
                  {step.icon && <img src={step.icon} alt="" width="40" height="40" class="size-7 shrink-0" />}
                  <span>{c.steps[step.key].title}</span>
                </h4>
                <p class="mt-1.5 text-[14px] leading-6 text-body">{c.steps[step.key].text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
