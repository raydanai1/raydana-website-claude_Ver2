---
import { serviceImages } from '../../data/services';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).services.hero;
---

<!-- Figma 2:19788 (background), 2:13097 / 2:13119 / 2:13096 (text). -->
<section class="relative -mt-[84px] overflow-hidden bg-[#eff2f7] lg:-mt-[118px]" aria-labelledby="services-hero-title">
  <div class="absolute inset-0 hidden lg:block" aria-hidden="true">
    <img
      src={serviceImages.heroBg}
      alt=""
      width="1664"
      height="678"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover object-[30%_center] ltr:-scale-x-100"
    />
  </div>

  <div class="container-x relative pb-10 pt-[112px] lg:min-h-[582px] lg:pb-16 lg:pt-[154px]">
    <div class="lg:max-w-[592px]">
      <h1 id="services-hero-title" class="text-[22px] font-bold leading-snug text-title lg:text-title-2">{t.title}</h1>
      <p class="mt-3 text-[16px] font-bold leading-snug text-sky lg:mt-[18px] lg:text-title-3">{t.subtitle}</p>
      <p class="mt-4 lg:text-justify text-[14px] leading-8 text-body lg:mt-5 lg:text-15">{t.body}</p>
    </div>
    <img
      src={serviceImages.heroCube}
      alt=""
      width="500"
      height="560"
      fetchpriority="high"
      class="mx-auto mt-6 w-[220px] sm:w-[260px] lg:hidden"
    />
  </div>
</section>
