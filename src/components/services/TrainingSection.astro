---
import SectionHeading from './SectionHeading.astro';
import QuoteButton from './QuoteButton.astro';
import { serviceImages, serviceSections } from '../../data/services';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
  ctaHref: string;
}
const { locale, ctaHref } = Astro.props;
const s = useTranslations(locale).services;
---

<!-- Figma ver4 "LERNING" 4001:4146: tinted band 584 high with card 2:15359 (1320×465, image 625 wide). -->
<section id={serviceSections.training} class="scroll-mt-28 bg-tint py-8 lg:py-[59px]" aria-labelledby="training-title">
  <div class="container-x">
    <div class="grid overflow-hidden rounded-[18px] bg-white shadow-soft lg:min-h-[465px] lg:grid-cols-[695fr_625fr]">
      <div class="flex flex-col px-5 pb-6 pt-6 sm:px-8 lg:pb-[45px] lg:pe-[32px] lg:ps-[37px] lg:pt-[43px]">
        <SectionHeading id="training-title">{s.training.title}</SectionHeading>
        <p class="mt-4 text-[14px] leading-7 text-body lg:mt-[29px] lg:text-15 lg:leading-8">{s.training.body}</p>
        <QuoteButton href={ctaHref} class="mt-6 lg:mt-auto lg:me-[5px] lg:w-auto">{s.quote}</QuoteButton>
      </div>
      <img
        src={serviceImages.training}
        alt={s.training.imageAlt}
        width="1250"
        height="822"
        loading="lazy"
        class="order-first aspect-[16/10] w-full rounded-b-[18px] object-cover lg:order-none lg:aspect-auto lg:h-full lg:rounded-none"
      />
    </div>
  </div>
</section>
