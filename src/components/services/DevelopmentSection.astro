---
import SectionHeading from './SectionHeading.astro';
import QuoteButton from './QuoteButton.astro';
import { developmentHexes, serviceImages, serviceSections } from '../../data/services';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
  ctaHref: string;
}
const { locale, ctaHref } = Astro.props;
const s = useTranslations(locale).services;
---

<!--
  Figma 2:13120 (text card) + 2:13175 (IT professions illustration, gradient 2:15048)
  + hexagon badges 2:15100… with their labels (rebuilt as real text).
-->
<section id={serviceSections.development} class="scroll-mt-28 bg-tint py-10 lg:py-[60px]" aria-labelledby="development-title">
  <div class="container-x">
    <div class="grid overflow-hidden rounded-[18px] bg-white shadow-soft lg:min-h-[465px] lg:grid-cols-[683fr_637fr]">
      <div class="flex flex-col px-5 pb-6 pt-8 sm:px-8 lg:pb-[49px] lg:pe-[37px] lg:ps-[46px] lg:pt-[46px]">
        <SectionHeading id="development-title">{s.development.title}</SectionHeading>
        <p class="mt-5 lg:text-justify text-[14px] leading-8 text-body lg:mt-[30px] lg:text-15">{s.development.body}</p>
        <QuoteButton href={ctaHref} class="mt-8 lg:mt-auto">{s.quote}</QuoteButton>
      </div>

      <div class="relative order-first isolate overflow-hidden bg-[#0b2565] lg:order-none">
        <img
          src={serviceImages.developmentArt}
          alt=""
          width="946"
          height="808"
          loading="lazy"
          class="absolute left-[4.4%] top-[7.6%] -z-10 h-[87%] w-[74%] object-contain"
        />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(126deg,rgba(32,83,208,0.72)_1.3%,rgba(0,12,40,0.72)_84.3%)]"></div>
        <ul class="mx-auto flex max-w-[480px] flex-wrap justify-center gap-y-6 px-2 py-10 sm:py-14 lg:gap-y-[46px] lg:px-0 lg:pb-12 lg:pt-[79px]">
          {
            developmentHexes.map((key) => (
              <li class="flex w-[46%] flex-col items-center gap-3 text-center sm:w-[155px]">
                <img src={serviceImages.devHex} alt="" width="78" height="78" class="size-16 lg:size-[78px]" />
                <span class="max-w-[130px] text-[14px] font-bold leading-6 text-white lg:text-[16px]">{s.development.hexes[key]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
