---
import { serviceCards, serviceImages } from '../../data/services';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).services.grid;
---

<!-- Figma 2:13108 (title) and 2:15402 (8 service cards). -->
<section class="container-x pb-14 pt-12 lg:pb-[177px] lg:pt-[86px]" aria-labelledby="services-grid-title">
  <h2 id="services-grid-title" class="text-center text-[20px] font-bold leading-snug text-title md:text-title-2">{t.title}</h2>

  <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-[65px] lg:grid-cols-4 lg:gap-x-6 lg:gap-y-[42px]">
    {
      serviceCards.map((card) => {
        const Tag = 'section' in card ? 'a' : 'div';
        return (
          <li>
            <Tag
              href={'section' in card ? `#${card.section}` : undefined}
              class:list={[
                'group flex h-[102px] items-center gap-2 rounded-[20px] border-[0.86px] border-stroke bg-white pe-[17px] ps-[10px] shadow-industry',
                'section' in card && 'transition duration-300 hover:-translate-y-1 hover:border-stroke-strong',
              ]}
            >
              <span class="relative size-[82px] shrink-0">
                {'hex' in card ? (
                  <img src={card.hex} alt="" width="82" height="82" class="size-full" />
                ) : (
                  <>
                    <img src={card.poly} alt="" width="71" height="80" class="absolute inset-y-[1.5%] inset-x-[6.7%] h-[97%] w-[86.6%]" />
                    <img src={card.icon} alt="" width="26" height="27" class="absolute left-1/2 top-1/2 h-[27px] w-[26px] -translate-x-1/2 -translate-y-1/2" />
                  </>
                )}
              </span>
              <span class="flex-1 text-15 font-bold leading-8 text-title">{t.items[card.key]}</span>
              <span class="icon-btn group-hover:bg-light-4" aria-hidden="true">
                <img src={serviceImages.cardArrow} alt="" width="18" height="18" class="dir-icon-rev size-[18px]" />
              </span>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</section>
