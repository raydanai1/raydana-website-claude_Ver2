---
import { serviceCards, serviceImages } from '../../data/services';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).services.grid;
---

<!--
  Figma ver4 4001:4145: title 2:13108 (top 668) and 8 cards 311×102 in two rows (735, 861), 24px gaps.
  Phones: compact 2-column grid with the icon above the title.
-->
<section class="container-x pb-10 pt-10 lg:pb-[95px] lg:pt-[81px]" aria-labelledby="services-grid-title">
  <h2 id="services-grid-title" class="text-center text-[20px] font-bold leading-snug text-title md:text-title-2 lg:leading-[42px]">{t.title}</h2>

  <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-[25px] lg:grid-cols-4 lg:gap-6">
    {
      serviceCards.map((card) => {
        const linked = 'section' in card;
        const Tag = linked ? 'a' : 'div';
        return (
          <li>
            <Tag
              href={linked ? `#${card.section}` : undefined}
              class:list={[
                'group flex h-full flex-col items-center gap-2 rounded-2xl border-[0.86px] border-stroke bg-white px-2 pb-4 pt-3 text-center shadow-industry',
                'sm:min-h-[102px] sm:flex-row sm:gap-0 sm:rounded-[20px] sm:pb-0 sm:pe-[15px] sm:ps-[11px] sm:pt-0 sm:text-start lg:h-[102px]',
                linked && 'transition duration-300 hover:-translate-y-1 hover:border-stroke-strong',
              ]}
            >
              <span class="relative size-16 shrink-0 sm:size-[82px]">
                {'hex' in card ? (
                  <img src={card.hex} alt="" width="82" height="82" class="size-full" />
                ) : (
                  <>
                    <img src={card.poly} alt="" width="71" height="80" class="absolute inset-y-[1.5%] inset-x-[6.7%] h-[97%] w-[86.6%]" />
                    <img src={card.icon} alt="" width="26" height="27" class="absolute left-1/2 top-1/2 h-[21px] w-5 -translate-x-1/2 -translate-y-1/2 sm:h-[27px] sm:w-[26px]" />
                  </>
                )}
              </span>
              <span class="text-[13px] font-bold leading-5 text-title [overflow-wrap:anywhere] sm:flex-1 sm:ps-1.5 sm:text-15 sm:leading-6">{t.items[card.key]}</span>
              <span class="icon-btn hidden group-hover:bg-light-4 sm:inline-flex" aria-hidden="true">
                <img src={serviceImages.cardArrow} alt="" width="18" height="18" class="dir-icon-rev size-[18px]" />
              </span>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</section>
