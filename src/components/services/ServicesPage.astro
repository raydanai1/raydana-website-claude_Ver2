---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import ServicesHero from './ServicesHero.astro';
import ServicesGrid from './ServicesGrid.astro';
import TrainingSection from './TrainingSection.astro';
import CustomizationSection from './CustomizationSection.astro';
import SupportSection from './SupportSection.astro';
import DeploymentSection from './DeploymentSection.astro';
import { homePath, type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
// The quote buttons lead to the same demo section as the homepage CTA.
const ctaHref = `${homePath(locale)}#demo`;
---

<Layout locale={locale} page="services" title={t.services.meta.title} description={t.services.meta.description}>
  <Header locale={locale} page="services" />
  <main id="main">
    <ServicesHero locale={locale} />
    <ServicesGrid locale={locale} />
    <TrainingSection locale={locale} ctaHref={ctaHref} />
    <CustomizationSection locale={locale} />
    <SupportSection locale={locale} ctaHref={ctaHref} />
    <DeploymentSection locale={locale} ctaHref={ctaHref} />
  </main>
  <Footer locale={locale} />
</Layout>
