---
import SectionHeading from './SectionHeading.astro';
import QuoteButton from './QuoteButton.astro';
import { serviceImages, serviceSections, supportHexes } from '../../data/services';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
  ctaHref: string;
}
const { locale, ctaHref } = Astro.props;
const s = useTranslations(locale).services;
const ringMask = `mask:url(${serviceImages.ring}) center/contain no-repeat;-webkit-mask:url(${serviceImages.ring}) center/contain no-repeat;`;
---

<!-- Figma 2:15555 / 2:15562 / 2:15563 (text card) and 2:15373, 94:1010… (hexagon ring cluster). -->
<section id={serviceSections.support} class="scroll-mt-28 py-12 lg:pb-[104px] lg:pt-[81px]" aria-labelledby="support-title">
  <div class="container-x grid items-start gap-10 lg:grid-cols-[1fr_655px] lg:gap-6">
    <div class="flex flex-col rounded-[18px] bg-white px-5 pb-8 pt-8 shadow-soft sm:px-8 lg:order-2 lg:min-h-[680px] lg:px-[41px] lg:pb-[50px] lg:pt-[55px]">
      <SectionHeading id="support-title">{s.support.title}</SectionHeading>
      <p class="mt-5 text-15 font-bold leading-8 text-primary">{s.support.intro}</p>
      <ul class="mt-2 list-disc ps-[22px] text-[14px] leading-8 text-body lg:text-15">
        {s.support.items.map((item) => <li>{item}</li>)}
      </ul>
      <QuoteButton href={ctaHref} class="mt-8 lg:mt-auto">{s.quote}</QuoteButton>
    </div>

    <!-- Desktop: scattered rings as in Figma. Mobile/tablet: a grid of ring badges. -->
    <ul class="grid grid-cols-2 justify-items-center gap-x-2 gap-y-4 sm:grid-cols-3 lg:relative lg:mx-auto lg:mt-[-4px] lg:block lg:h-[610px] lg:w-[542px] lg:max-w-full">
      {
        supportHexes.map((hex) => (
          <li
            class:list={[
              'relative flex size-[150px] items-center justify-center lg:absolute lg:size-[174px] lg:[inset-inline-start:var(--x)] lg:top-[var(--y)]',
              !hex.key && 'max-lg:hidden',
            ]}
            style={`--x:${hex.x}px;--y:${hex.y}px`}
            aria-hidden={hex.key ? undefined : 'true'}
          >
            <span class="absolute inset-0" style={`background:${hex.color};${ringMask}transform:rotate(${hex.rotate}deg)`} />
            {hex.key && (
              <span class="relative w-[92px] text-center text-[14px] font-bold leading-6 text-title">{s.support.hexes[hex.key]}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
