---
import SectionHeading from './SectionHeading.astro';
import QuoteButton from './QuoteButton.astro';
import { deploymentSteps, serviceImages, serviceSections } from '../../data/services';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
  ctaHref: string;
}
const { locale, ctaHref } = Astro.props;
const s = useTranslations(locale).services;
const d = s.deployment;
---

<!--
  Figma 2:13130 (methodology card) and the timeline: 2:15205 (title), 2:15307…2:15346 (steps),
  2:15545 (hexagon number badges), 94:1007 (dotted line + dots), 2:15368 / 2:15371 (final delivery).
-->
<section id={serviceSections.deployment} class="scroll-mt-28 bg-tint py-12 lg:pb-5 lg:pt-[67px]" aria-labelledby="deployment-title">
  <div class="container-x grid items-start gap-12 lg:grid-cols-[637fr_653fr] lg:gap-[30px]">
    <!-- Methodology card (start side) -->
    <div class="flex flex-col rounded-[18px] bg-white px-5 pb-8 pt-8 shadow-soft sm:px-8 lg:px-[35px] lg:pb-[36px] lg:pt-[34px]">
      <SectionHeading id="deployment-title">{d.title}</SectionHeading>
      <p class="mt-4 lg:text-justify text-[14px] leading-8 text-body lg:text-15">{d.body}</p>
      <img
        src={serviceImages.deployment}
        alt={d.imageAlt}
        width="740"
        height="465"
        loading="lazy"
        class="mt-5 aspect-[559/180] w-full rounded-[14px] object-cover"
      />
      <h3 class="mt-10 text-[16px] font-bold leading-snug text-title lg:mt-[46px] lg:text-title-3">{d.functionsTitle}</h3>
      <ul class="mt-6 space-y-4 lg:space-y-[18px]">
        {
          d.functions.map((item) => (
            <li class="flex items-center gap-4">
              <img src={serviceImages.check} alt="" width="50" height="50" class="size-[50px] shrink-0" />
              <span class="text-[14px] font-bold leading-6 text-body">{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 lg:text-justify text-[14px] leading-8 text-body lg:text-15">{d.itil}</p>
      <QuoteButton href={ctaHref} class="mt-8 lg:mt-[22px]">{s.quote}</QuoteButton>
    </div>

    <!-- Timeline (end side) -->
    <div>
      <div class="tilt-wrap mx-auto mt-4 max-w-[572px] lg:mt-[37px] lg:me-[28px] lg:ms-auto">
        <span class="tilt-back" aria-hidden="true"></span>
        <h3 class="tilt-card px-5 py-5 text-[15px] font-bold leading-[30px] text-title lg:px-6 lg:py-[11px] lg:text-[16px] lg:leading-[34px]">
          {d.timelineTitle}
        </h3>
      </div>

      <div class="relative mt-10 lg:mt-[86px]">
        <span
          class="absolute bottom-[70px] top-0 start-[11px] border-s-2 border-dotted border-[#9ec4ce] lg:start-[calc(50%-1px)]"
          aria-hidden="true"
        ></span>
        <ol class="relative flex flex-col gap-4 lg:gap-[10px]">
          {
            deploymentSteps.map((step, i) => {
              const startSide = i % 2 === 0;
              const n = i + 1;
              const title = d.steps[step.key].title;
              const text = step.text === 'own' ? (d.steps[step.key] as { text: string }).text : step.text === 'shared' ? d.stepText : '';
              return (
                <li class="grid grid-cols-[24px_1fr] items-center gap-x-3 lg:grid-cols-[1fr_26px_1fr] lg:gap-x-[13px]">
                  <img
                    src={serviceImages.timelineDot}
                    alt=""
                    width="23"
                    height="23"
                    class="col-start-1 row-start-1 size-[23px] justify-self-center lg:col-start-2"
                  />
                  <div
                    class:list={[
                      'col-start-2 row-start-1 rounded-[18px] bg-white shadow-soft',
                      startSide ? 'lg:col-start-1 lg:justify-self-end' : 'lg:col-start-3 lg:justify-self-start',
                      'compact' in step ? 'flex items-center gap-2 justify-self-start px-[22px] py-[18px]' : 'w-full px-[18px] pb-6 pt-4 lg:min-h-[147px] lg:w-[300px] lg:ps-[18px] lg:pe-6',
                    ]}
                  >
                    {'compact' in step ? (
                      <>
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-[#ebf3ff] text-[20px] font-bold leading-none text-[#0167fe]">{n}</span>
                        <h4 class="text-title-3 font-bold leading-normal text-title">{title}</h4>
                      </>
                    ) : (
                      <>
                        <div class="flex items-center gap-3">
                          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-[#ebf3ff] text-[22px] font-bold leading-none text-[#0167fe]">{n}</span>
                          <h4 class:list={['font-bold leading-normal text-title', 'latin' in step ? 'text-[20px]' : 'text-title-3']} dir="auto">
                            {title}
                          </h4>
                        </div>
                        <p class="mt-2 text-[14px] leading-6 text-muted">{text}</p>
                      </>
                    )}
                  </div>
                  <div
                    class:list={[
                      'row-start-1 hidden items-center lg:flex',
                      startSide ? 'lg:col-start-3' : 'lg:col-start-1 lg:flex-row-reverse lg:justify-self-end',
                    ]}
                    aria-hidden="true"
                  >
                    <span class="w-[58px] border-t-2 border-dotted border-[#9ec4ce]"></span>
                    <span class="relative flex h-[96px] w-[99px] items-center justify-center">
                      <img
                        src={serviceImages.badgeOuter}
                        alt=""
                        width="96"
                        height="99"
                        class:list={[
                          'absolute h-[99px] w-[96px] max-w-none',
                          startSide ? 'rtl:-rotate-90 ltr:rotate-90' : 'rtl:rotate-90 ltr:-rotate-90',
                        ]}
                      />
                      <img src={serviceImages.badgeInner} alt="" width="67" height="74" class="relative mt-2 h-[74px] w-[67px]" />
                      <span class="absolute inset-0 flex items-center justify-center text-[22px] font-bold text-[#0167fe]">{n}</span>
                    </span>
                  </div>
                </li>
              );
            })
          }
        </ol>

        <div class="relative mt-8 flex w-[140px] items-center justify-center lg:mx-auto lg:mt-[46px]">
          <img src={serviceImages.finalRing} alt="" width="149" height="149" class="absolute -top-[2px] left-1/2 h-[149px] w-[149px] max-w-none -translate-x-1/2" />
          <span class="relative m-2 flex size-[124px] items-center justify-center rounded-full bg-[#a29cff] text-center text-title-3 font-bold text-white">
            {d.final}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
