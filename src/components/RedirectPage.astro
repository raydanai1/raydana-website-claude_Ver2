---
/**
 * Forwarding page. On Apache the .htaccess 301 rules answer first, so visitors normally never see this;
 * on hosts without .htaccess support the meta refresh (plus canonical) takes over.
 * - legacy:   an old URL that moved to a new one.
 * - fallback: a Russian/Arabic page that is not translated yet — forwards to the English page.
 */
import { localeInfo, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  to: string;
  reason: 'legacy' | 'fallback';
}
const { locale, to, reason } = Astro.props;
const { dir, htmlLang } = localeInfo[reason === 'fallback' ? 'en' : locale];
const href = new URL(to, Astro.site ?? 'https://raydana.com').href;
const message =
  reason === 'fallback'
    ? { en: 'This page is not available in this language yet — opening the English version…', link: 'Continue' }
    : { en: 'This page has moved…', link: 'Continue' };
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Raydana</title>
    <link rel="canonical" href={href} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem; color: #3b4561">
    <p>{message.en} <a href={to}>{message.link}</a></p>
  </body>
</html>
