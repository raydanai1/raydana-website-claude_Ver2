---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Button from '../ui/Button.astro';
import FeaturedSlider from './FeaturedSlider.astro';
import CategoryPills from './CategoryPills.astro';
import WideCard from './WideCard.astro';
import GridCard from './GridCard.astro';
import {
  getKnowledgeItems,
  itemsInCategory,
  knowledgeCategories,
  knowledgeCategoryNames,
  knowledgeCategoryPath,
  sliderItems,
  type KnowledgeCategory,
} from '../../data/knowledge';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).knowledge;

const items = await getKnowledgeItems(locale);
const byCategory = (c: KnowledgeCategory) => itemsInCategory(items, c);

// Figma ver4 (33:6798): the newest 2 events as wide cards, then 3 articles in a grid.
const sections = [
  { category: 'events' as const, limit: 2, wide: true, more: t.viewAll },
  { category: 'articles' as const, limit: 3, wide: false, more: t.viewAllArticles },
]
  .map((s) => ({ ...s, all: byCategory(s.category) }))
  .filter((s) => s.all.length > 0);
// All categories always get a pill: a section on this page when there is one, else the category page.
const pills = knowledgeCategories.map((category) => ({
  category,
  href: sections.some((s) => s.category === category) ? `#${category}` : knowledgeCategoryPath(category, locale),
}));
---

<Layout locale={locale} page="knowledge" title={t.meta.title} description={t.meta.description}>
  <Header locale={locale} page="knowledge" />
  <main id="main">
    {items.length > 0 && <FeaturedSlider locale={locale} items={sliderItems(items)} />}
    {items.length === 0 && (
      <section class="container-x py-24 text-center">
        <h1 class="section-title">{t.title}</h1>
        <p class="mt-4 text-15 leading-8 text-body">{t.empty}</p>
      </section>
    )}

    <CategoryPills
      locale={locale}
      pills={pills}
      class="container-x mt-10 lg:mt-[44px]"
    />

    {
      sections.map((s, index) => (
        <section
          id={s.category}
          class:list={['container-x scroll-mt-28', index === 0 ? 'mt-8 lg:mt-[44px]' : 'mt-16 lg:mt-[110px]']}
          aria-labelledby={`${s.category}-title`}
        >
          <h2 id={`${s.category}-title`} class:list={['text-center text-title-3 font-bold leading-[1.47] text-ink', s.wide && 'sr-only']}>
            {knowledgeCategoryNames[s.category][locale]}
          </h2>
          {s.wide ? (
            <div class="flex flex-col gap-6 lg:gap-[26px]">
              {s.all.slice(0, s.limit).map((item, i) => (
                <WideCard item={item} locale={locale} imageFirst={i % 2 === 1} />
              ))}
            </div>
          ) : (
            <div class="mt-6 grid gap-x-[46px] gap-y-12 sm:grid-cols-2 lg:mt-[33px] lg:grid-cols-3 lg:gap-y-16">
              {s.all.slice(0, s.limit).map((item) => <GridCard item={item} locale={locale} />)}
            </div>
          )}
          {s.all.length > s.limit && (
            <div class="mt-10 flex justify-center">
              <Button href={knowledgeCategoryPath(s.category, locale)} variant="outline">{s.more}</Button>
            </div>
          )}
        </section>
      ))
    }

    <div class="h-6 lg:h-[40px]" aria-hidden="true"></div>
  </main>
  <Footer locale={locale} />
</Layout>
