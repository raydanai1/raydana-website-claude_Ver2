---
import { contactCards, contactImages } from '../../data/contact';
import { localizeDigits, type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).contact.cards;
---

<!-- Figma 37:574: four 309×370 cards, pastel hexagon icons, outline pill buttons. -->
<section class="container-x pt-[30px]" aria-labelledby="contact-cards-title">
  <h2 id="contact-cards-title" class="sr-only">{t.title}</h2>
  <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {
      contactCards.map((card) => (
        <li class="flex flex-col items-center rounded-[18.19px] bg-white px-5 pb-9 pt-10 text-center shadow-industry lg:min-h-[370px]">
          <img src={card.icon} alt="" width={card.iconW} height={card.iconH} loading="lazy" class="h-auto w-[81px]" />
          <h3 class="mt-[15px] text-15 font-bold leading-[34.1px] text-[#575757]">{t[card.key].title}</h3>

          {card.key === 'address' ? (
            <p class="mb-3 mt-[14px] max-w-[281px] text-[15.9px] font-medium leading-8 text-[#838897]">{t.address.text}</p>
          ) : (
            <div class="mt-[9px] flex flex-col text-[15.9px] font-medium leading-[34.1px] text-[#838897]">
              {card.phone && (
                <a href={`tel:${card.phone.tel}`} class="tracking-[2px] transition-colors hover:text-[#555dfa]" aria-label={`${t.phoneLabel}: ${card.phone.display}`}>
                  <span dir="ltr">{localizeDigits(card.phone.display, locale)}</span>
                </a>
              )}
              {card.email && (
                <a href={`mailto:${card.email}`} class="tracking-[1.75px] transition-colors hover:text-[#555dfa]" dir="ltr">
                  {card.email}
                </a>
              )}
            </div>
          )}

          <a
            href={card.href}
            class="mt-auto inline-flex h-12 min-w-[240px] max-w-full items-center justify-center gap-3 rounded-full border border-[#555dfa] px-5 text-base font-medium leading-6 whitespace-nowrap text-[#555dfa] drop-shadow-[0_0_8px_rgba(55,183,195,0.25)] transition-colors hover:bg-[#555dfa]/5 max-lg:mt-6"
          >
            {t[card.key].action}
            <img src={contactImages.arrow} alt="" width="12.5" height="11.0459" class="dir-icon h-[11px] w-[12.5px]" />
          </a>
        </li>
      ))
    }
  </ul>
</section>
