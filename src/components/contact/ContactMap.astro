---
import { googleMapsUrl, officeLocation } from '../../data/contact';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).contact.map;

// OpenStreetMap embed (no API key): a small box around the office with a marker on it.
const { lat, lon } = officeLocation;
const d = { lat: 0.0035, lon: 0.0075 };
const bbox = [lon - d.lon, lat - d.lat, lon + d.lon, lat + d.lat].map((n) => n.toFixed(4)).join(',');
const embedSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
---

<!-- Figma 37:624: full-width 1432×499 map band, flush with the footer. The Google link sits bottom-left in both
     directions, clear of the OSM zoom buttons (top-right) and attribution (bottom-right). -->
<section id="map" class="relative mx-auto -mb-16 mt-12 max-w-[1432px] scroll-mt-28 lg:-mb-[50px] lg:mt-[59px]" aria-label={t.title}>
  <iframe
    src={embedSrc}
    title={t.title}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="block h-[320px] w-full border-0 bg-light-4 lg:h-[499px]"></iframe>
  <a
    href={googleMapsUrl}
    target="_blank"
    rel="noopener"
    class="absolute bottom-4 left-4 inline-flex h-10 items-center gap-2 rounded-full bg-white px-4 text-sm font-medium text-primary shadow-header transition-colors hover:bg-light"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      <circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.8"></circle>
    </svg>
    {t.google}
  </a>
</section>
