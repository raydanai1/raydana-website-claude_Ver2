---
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="demo" class="-mt-9 scroll-mt-24 bg-deep pb-14 pt-24 lg:pb-[76px] lg:pt-[127px]" aria-labelledby="demo-title">
  <div class="container-x">
    <div class="mx-auto max-w-[1302px] text-center">
      <h2 id="demo-title" class="text-[20px] font-bold text-[#f0f8ff] lg:text-title-2">{t.demo.title}</h2>
      <p class="mx-auto mt-3 max-w-[521px] text-[15px] font-bold leading-relaxed text-sky lg:mt-4 lg:text-title-3">{t.demo.subtitle}</p>
      <p class="mt-2 text-[15px] font-bold leading-relaxed text-light lg:text-title-3">{t.demo.body}</p>
    </div>

    <!-- Monitor mock-up (Figma 2068:3924) -->
    <div class="relative mx-auto mt-8 w-full max-w-[843px] rounded-[18px] bg-black p-[3%] pb-[7%] lg:mt-[66px] lg:rounded-[29px]">
      <div class="relative aspect-[795/508] overflow-hidden">
        <img
          src="/images/demo/screen.webp"
          alt={t.demo.imageAlt}
          width="1440"
          height="700"
          loading="lazy"
          class="absolute inset-0 size-full object-contain"
        />
        <div class="absolute inset-0 bg-[rgba(53,70,120,0.37)]"></div>
        <div class="demo-vignette absolute inset-x-0 top-[10.4%] h-[78.4%] opacity-25"></div>
        <button
          type="button"
          class="absolute left-1/2 top-1/2 flex h-[58px] w-[58px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-[34px] bg-primary shadow-lg transition hover:scale-110 focus-visible:scale-110"
          aria-label={t.a11y.play}
          data-demo-play
        >
          <img src="/images/demo/play.svg" alt="" width="18" height="23" />
        </button>
      </div>
      <img
        src="/images/demo/home-button.svg"
        alt=""
        width="38"
        height="38"
        class="absolute bottom-[1.8%] left-1/2 size-[4.5%] -translate-x-1/2"
      />
    </div>
    <p class="mt-4 hidden text-center text-sm text-light/80" role="status" data-demo-msg>{t.demo.soon}</p>
  </div>
</section>

<style>
  .demo-vignette {
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(220, 223, 224, 1) 0%,
      rgba(111, 123, 150, 0.95) 50%,
      rgba(56, 73, 113, 0.925) 75%,
      rgba(2, 23, 76, 0.9) 100%
    );
  }
</style>

<script>
  // No video file was supplied with the design; the play button shows a notice until one is added.
  document.querySelector('[data-demo-play]')?.addEventListener('click', () => {
    document.querySelector('[data-demo-msg]')?.classList.remove('hidden');
  });
</script>
