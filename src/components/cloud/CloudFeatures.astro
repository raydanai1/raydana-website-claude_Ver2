---
import { cloudImages } from '../../data/cloud';
import type { Locale } from '../../i18n';

interface Tab {
  key: string;
  label: string;
  items: readonly string[];
}
interface Props {
  locale: Locale;
  title: string;
  tabs: Tab[];
  /** Prefix for element ids (must be unique on the page). */
  id?: string;
  /** Second-column dot. */
  dotEnd?: string;
  /** Grid columns of the feature list from 768px. */
  columns?: string;
  /** Max width of the feature list. */
  listWidth?: string;
  /** Space between the tab row and the feature list from 1024px. */
  listGap?: string;
  /** Section padding. */
  spacing?: string;
  /** Extra title classes (e.g. another colour). */
  titleClass?: string;
}
const {
  title,
  tabs,
  id = 'cloud',
  dotEnd = cloudImages.dotStart,
  columns = 'md:grid-cols-[638fr_506fr]',
  listWidth = 'max-w-[1179px]',
  listGap = 'lg:mt-[47px]',
  spacing = 'pb-16 pt-12 lg:pb-[160px] lg:pt-[58px]',
  titleClass,
} = Astro.props;
---

<!-- Figma 5:33221 (title + tabs) and 5:33253 (feature list of the active tab). -->
<section class:list={['bg-light', spacing]} aria-labelledby={`${id}-features-title`}>
  <div class="container-x">
    <h2 id={`${id}-features-title`} class:list={['section-title text-center', titleClass]}>{title}</h2>

    <div
      class="cloud-tabs -mx-4 mt-6 flex gap-[8px] overflow-x-auto px-4 py-3 sm:-mx-6 sm:px-6 lg:mx-0 lg:mt-[25px] lg:flex-wrap lg:justify-center lg:overflow-visible lg:px-0"
      role="tablist"
      aria-labelledby={`${id}-features-title`}
      data-cloud-tabs
    >
      {
        tabs.map(({ key, label }, i) => (
          <button
            type="button"
            role="tab"
            id={`${id}-tab-${key}`}
            aria-controls={`${id}-panel-${key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="cloud-tab group flex h-[52px] shrink-0 items-center justify-center gap-[4px] whitespace-nowrap rounded-[29px] border px-[14px] text-base font-medium leading-6 transition-colors duration-200"
          >
            <span>{label}</span>
            <img src={cloudImages.tabArrowWhite} alt="" width="18" height="18" class="tab-icon-active size-[18px] -rotate-90" />
            <img src={cloudImages.tabArrowBlue} alt="" width="18" height="18" class="tab-icon-idle dir-icon size-[18px]" />
          </button>
        ))
      }
    </div>

    {
      tabs.map(({ key, items }, i) => {
        const rows = Math.ceil(items.length / 2);
        return (
          <div
            role="tabpanel"
            id={`${id}-panel-${key}`}
            aria-labelledby={`${id}-tab-${key}`}
            hidden={i !== 0}
            class:list={['mx-auto mt-8', listWidth, listGap]}
          >
            <ul
              class:list={['grid grid-cols-1 gap-y-3 md:grid-flow-col md:gap-x-[35px] md:gap-y-[12px]', columns]}
              style={`--rows:${rows}`}
            >
              {items.map((item, j) => (
                <li class="flex items-start gap-[20px] ps-[22px] text-15 leading-8 text-body md:min-h-8">
                  <img
                    src={j < rows ? cloudImages.dotStart : dotEnd}
                    alt=""
                    width={j < rows || dotEnd === cloudImages.dotStart ? 10.53 : 8.36}
                    height="9"
                    class="mt-[11.5px] h-[9px] shrink-0"
                    style={`width:${j < rows || dotEnd === cloudImages.dotStart ? 10.53 : 8.36}px`}
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .cloud-tabs {
    scrollbar-width: none;
  }
  .cloud-tabs::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 768px) {
    [role='tabpanel'] ul {
      grid-template-rows: repeat(var(--rows), minmax(32px, auto));
    }
  }
  /* Inactive: pale fill, light blue edge, blue label, arrow toward the reading end. */
  .cloud-tab {
    border-color: #c4d3fb;
    background-color: rgba(213, 224, 252, 0.1);
    color: #0f53f8;
  }
  .cloud-tab:hover {
    background-color: rgba(213, 224, 252, 0.35);
  }
  .cloud-tab .tab-icon-active {
    display: none;
  }
  /* Active: blue → violet gradient, white label, chevron turned down. */
  .cloud-tab[aria-selected='true'] {
    border-color: transparent;
    background-image: linear-gradient(to right, #0968ff 2.756%, #6b68ff);
    color: #fff;
    box-shadow: 0 0 16px rgba(55, 183, 195, 0.25);
  }
  .cloud-tab[aria-selected='true'] .tab-icon-active {
    display: block;
  }
  .cloud-tab[aria-selected='true'] .tab-icon-idle {
    display: none;
  }
</style>

<script>
  // Tabs: click or arrow keys switch the visible feature list.
  document.querySelectorAll<HTMLElement>('[data-cloud-tabs]').forEach((list) => {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const other of tabs) {
        const active = other === tab;
        other.setAttribute('aria-selected', String(active));
        other.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !active;
      }
      if (focus) tab.focus();
      tab.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const rtl = document.documentElement.dir === 'rtl';
        const next = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[e.key];
        if (next !== undefined) {
          e.preventDefault();
          select(tabs[(i + next + tabs.length) % tabs.length], true);
        } else if (e.key === 'Home' || e.key === 'End') {
          e.preventDefault();
          select(tabs[e.key === 'Home' ? 0 : tabs.length - 1], true);
        }
      });
    });
  });
</script>
