---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import CloudHero from './CloudHero.astro';
import CloudBenefits from './CloudBenefits.astro';
import CloudFeatures from './CloudFeatures.astro';
import DemoRequestForm from './DemoRequestForm.astro';
import Faq from './Faq.astro';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} page="cloud" title={t.cloud.meta.title} description={t.cloud.meta.description}>
  <Header locale={locale} page="cloud" />
  <main id="main">
    <CloudHero locale={locale} ctaHref="#demo" />
    <CloudBenefits locale={locale} />
    <CloudFeatures locale={locale} />
    <DemoRequestForm locale={locale} />
    <Faq locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
