---
import Button from '../ui/Button.astro';
import { cloudImages } from '../../data/cloud';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
  ctaHref: string;
}
const { locale, ctaHref } = Astro.props;
const t = useTranslations(locale).cloud.hero;
---

<!-- Figma ver4: 5:29111 (background), 6001:2161 (text block 557 wide: title, subtitle, two paragraphs, buttons, 15px apart), 102:11995 (illustration). -->
<section class="relative -mt-[76px] overflow-hidden bg-light-4 sm:-mt-[84px] lg:-mt-[112px]" aria-labelledby="cloud-hero-title">
  <div class="container-x relative pb-8 pt-[100px] sm:pt-[108px] lg:h-[582px] lg:pb-0 lg:pt-[157px]">
    <div class="flex flex-col gap-3 lg:max-w-[calc(100%-470px)] lg:gap-[15px] lg:pe-[25px] xl:max-w-[582px]">
      <h1 id="cloud-hero-title" class="text-[22px] font-bold leading-normal text-title lg:text-title-2">
        <span class="block">{t.kicker}</span>
        <span class="block">{t.title}</span>
      </h1>
      <p class="text-[16px] font-bold leading-normal text-primary lg:text-title-3 rtl:text-right" dir="ltr" lang="en">{t.product}</p>
      <div class="text-[14px] leading-7 text-body lg:text-15 lg:leading-8 rtl:text-justify">
        <p>{t.p1}</p>
        <p>{t.p2}</p>
      </div>
      <div class="mt-2 flex flex-wrap gap-[10px] lg:mt-0 lg:gap-[14px]">
        <Button href={ctaHref} class="grow sm:grow-0">{t.consult}</Button>
        <Button href={ctaHref} variant="outline" class="grow sm:grow-0">{t.demo}</Button>
      </div>
    </div>

    <!-- Illustration: glow clouds, pale hexagon and the server/cloud render, layered as in Figma (586×508). -->
    <div
      class="relative mx-auto mt-6 aspect-[586.49/508] w-full max-w-[280px] sm:mt-8 sm:max-w-[440px] lg:absolute lg:end-0 lg:top-[140px] lg:mt-0 lg:w-[440px] xl:end-[20px] xl:top-[74px] xl:w-[586.49px] xl:max-w-none"
      aria-hidden="true"
    >
      <img src={cloudImages.heroGlow} alt="" width="498.487" height="300.844" class="absolute left-[15.01%] top-[19.09%] w-[85%]" />
      <img src={cloudImages.heroHex} alt="" width="345.463" height="396.213" class="absolute left-[4.56%] top-[13.28%] w-[58.9%]" />
      <img
        src={cloudImages.heroServer}
        alt=""
        width="508"
        height="508"
        fetchpriority="high"
        class="absolute left-[1.13%] top-0 w-[86.62%]"
      />
    </div>
  </div>
</section>
