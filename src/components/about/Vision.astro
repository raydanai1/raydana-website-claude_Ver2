---
import SectionHeading from '../services/SectionHeading.astro';
import { aboutImages, visionItems } from '../../data/about';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).about.vision;
---

<!-- Figma 2015:10279 (card), 2018:14336 (cubes), 2033:10197-10199 (items), 2033:10229 (quote pill). -->
<section class="container-x pt-8 xl:pt-[33px]" aria-labelledby="vision-title">
  <div
    class="relative overflow-hidden rounded-2xl border-[0.856px] border-stroke bg-[#fafafa] px-5 pb-6 pt-8 shadow-[0_8px_16px_rgba(215,219,240,0.5)] sm:px-8 xl:min-h-[510px] xl:pb-[130px] xl:pe-[430px] xl:ps-[36px] xl:pt-[38px]"
  >
    <SectionHeading id="vision-title">{t.title}</SectionHeading>
    <p class="mt-4 text-15 font-bold leading-8 text-body xl:mt-[14px] xl:max-w-[770px] xl:pe-0 xl:ps-[0]">{t.body}</p>

    <!-- Cubes illustration: on top of the items on mobile, at the card's end side on desktop. -->
    <img
      src={aboutImages.visionCubes}
      alt=""
      width="834"
      height="763"
      loading="lazy"
      class="mx-auto mt-6 w-[260px] sm:w-[320px] xl:absolute xl:end-[8px] xl:top-[56px] xl:mt-0 xl:w-[417px]"
      aria-hidden="true"
    />

    <ul class="mt-6 grid gap-6 md:grid-cols-2 md:gap-x-10 xl:mt-[49px] xl:gap-x-[57px] xl:gap-y-[25px] xl:pe-0 xl:ps-[19px]">
      {
        visionItems.map((key) => (
          <li class="flex items-start gap-3">
            <img src={aboutImages.check} alt="" width="32" height="32" class="size-8 shrink-0" />
            <p class="pt-[3px]">
              <span class="block text-sm font-bold leading-6 text-primary">{t.items[key].title}</span>
              <span class="mt-1 block text-15 leading-8 text-body">{t.items[key].text}</span>
            </p>
          </li>
        ))
      }
    </ul>

    <p
      class="mt-8 rounded-[50.77px] border-[0.347px] border-neutral-200 bg-[#0b2565] px-6 py-4 text-center text-[15px] font-bold leading-normal text-light shadow-[0_8px_8px_rgba(0,0,0,0.25)] sm:text-[18px] xl:absolute xl:bottom-[42px] xl:end-[35px] xl:mt-0 xl:flex xl:h-[69px] xl:w-[658px] xl:items-center xl:justify-center xl:py-0"
    >
      {t.quote}
    </p>
  </div>
</section>
