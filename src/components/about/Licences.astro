---
import SnapStrip from './SnapStrip.astro';
import { licences } from '../../data/about';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).about.licences;
---

<!-- Figma ver4 6002:2496: title + seven licence logo cards (244×237) in a row that runs past the page edge. -->
<section class="pt-14 lg:pt-[110px]" aria-labelledby="licences-title">
  <h2 id="licences-title" class="container-x text-center text-[20px] font-bold leading-normal text-ink md:text-title-2">{t.title}</h2>
  <SnapStrip locale={locale} label={t.title} class="mt-5 lg:mt-0" navClass="lg:-mt-[40px] lg:mb-[18px]" gapClass="gap-3 sm:gap-4 lg:gap-6">
    {
      licences.map((item) => (
        <li class="w-[168px] rounded-[13.515px] border-[0.563px] border-stroke bg-[#fafafa] p-[8px] pb-6 shadow-[0_9.01px_19.959px_#dbe1f6] sm:w-[200px] sm:p-[10px] sm:pb-10 lg:h-[237px] lg:w-[244px]">
          <div class="flex aspect-[223.9/171.6] items-center justify-center rounded-[11.465px] bg-light-3 p-2">
            <img
              src={item.src}
              alt={t.items[item.key]}
              title={t.items[item.key]}
              width={item.w}
              loading="lazy"
              class="h-auto max-h-full object-contain"
              style={`width:${(item.w / 224) * 100}%`}
            />
          </div>
        </li>
      ))
    }
  </SnapStrip>
</section>
