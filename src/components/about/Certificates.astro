---
import { certificates } from '../../data/about';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).about.certificates;
---

<!-- Figma 2015:6537 (background), 2015:10117 (title + three certificate cards). -->
<section class="cert-bg py-12 lg:pb-[87px] lg:pt-[78px]" aria-labelledby="certificates-title">
  <div class="container-x">
    <h2 id="certificates-title" class="text-center text-[20px] font-bold leading-normal text-ink md:text-title-2">{t.title}</h2>
    <ul class="mx-auto mt-8 grid max-w-[1289px] gap-5 md:grid-cols-2 lg:mt-[46px] lg:grid-cols-3 lg:gap-[37px]">
      {
        certificates.map((cert) => {
          const name = t.names[cert.name];
          const [vendor, ...rest] = cert.course.split(' ');
          const [course, subtitle] = rest.join(' ').split(': ');
          return (
            <li class="mx-auto w-full max-w-[405px] rounded-[11.643px] border-[0.485px] border-stroke bg-[#fafafa] px-[17px] pb-4 pt-4 shadow-[0_7.762px_17.194px_#dbe1f6]">
              <div class="flex aspect-[371/257] items-center justify-center rounded-[9.877px] bg-light-3 p-[4%]">
                <img
                  src={cert.src}
                  alt={t.imageAlt.replace('{course}', cert.course).replace('{name}', name)}
                  width="1024"
                  height="780"
                  loading="lazy"
                  class="h-auto mix-blend-darken"
                  style={`width:${(cert.w / 371) * 100}%`}
                />
              </div>
              <div class="mt-4 flex items-start justify-between gap-3 px-[11px]">
                <p class="pt-[3px] text-[16px] font-bold leading-[1.47] text-navy">{name}</p>
                <p class="text-[16px] font-bold leading-[1.47] text-navy" dir="ltr" lang="en">
                  <span class="text-[#da2e2d]">{vendor}</span> {course}:
                  <br />
                  {subtitle}
                </p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .cert-bg {
    background: radial-gradient(817px 340px at 49.2% 29.5%, #e1eaee 0%, #cee1ea 50.5%, #e1eaee 100%);
  }
</style>
