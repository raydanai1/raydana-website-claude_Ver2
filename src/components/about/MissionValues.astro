---
import SectionHeading from '../services/SectionHeading.astro';
import { aboutImages, missionItems, valueItems } from '../../data/about';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).about;
const card =
  'rounded-2xl border-[0.856px] border-stroke bg-[#fafafa] px-5 pb-8 pt-8 shadow-[0_8px_16px_rgba(215,219,240,0.5)] sm:px-8 lg:px-[36px] lg:pb-12 lg:pt-[36px]';
---

<!-- Figma 2015:10281 (values card) + photo 2018:14350, 2015:10282 (mission card) + photo 2018:14349. -->
<section class="container-x grid gap-4 pt-4 lg:grid-cols-2 lg:gap-[17px] lg:pt-[10px]">
  <article class={card} aria-labelledby="values-title">
    <SectionHeading id="values-title">{t.values.title}</SectionHeading>
    <img
      src={aboutImages.values}
      alt=""
      width="1600"
      height="1067"
      loading="lazy"
      class="mt-5 h-[140px] w-full rounded-[9px] object-cover sm:h-[180px] lg:mt-[17px] lg:h-[137px]"
    />
    <ul class="mt-8 space-y-4 lg:mt-[54px] lg:space-y-[14px]">
      {
        valueItems.map((key) => (
          <li>
            <h3 class="text-sm font-bold leading-6 text-primary">{t.values.items[key].title}</h3>
            <p class="text-sm font-bold leading-6 text-body">{t.values.items[key].text}</p>
          </li>
        ))
      }
    </ul>
  </article>

  <article class={card} aria-labelledby="mission-title">
    <SectionHeading id="mission-title">{t.mission.title}</SectionHeading>
    <img
      src={aboutImages.mission}
      alt=""
      width="740"
      height="476"
      loading="lazy"
      class="mt-5 h-[140px] w-full rounded-[9px] object-cover sm:h-[180px] lg:mt-[17px] lg:h-[137px]"
    />
    <p class="mt-8 text-15 leading-8 text-body lg:mt-[39px]">{t.mission.body}</p>
    <ul class="mt-5 space-y-3 lg:mt-[22px] lg:space-y-[6px]">
      {
        missionItems.map((key) => (
          <li>
            <h3 class="text-15 font-bold leading-8 text-primary">{t.mission.items[key].title}</h3>
            <p class="text-15 leading-8 text-body">{t.mission.items[key].text}</p>
          </li>
        ))
      }
    </ul>
  </article>
</section>
