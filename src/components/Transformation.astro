---
import { transformCards } from '../data/home';
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const STAGE_W = 1184;
const STAGE_H = 512;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---

<section id="transform" class="container-x mt-16 scroll-mt-28 lg:mt-[54px]" aria-labelledby="transform-title">
  <div class="mx-auto max-w-[1138px] text-center">
    <h2 id="transform-title" class="section-title">{t.transform.title}</h2>
    <p class="mt-3 flex flex-col items-center justify-center gap-1 text-[15px] font-bold leading-relaxed text-primary sm:flex-row sm:gap-3 lg:text-title-3">
      <span dir="auto">{t.transform.leadBrand}</span>
      <span>{t.transform.lead}</span>
    </p>
    <p class="mt-3 text-[14px] leading-8 text-body lg:text-15">{t.transform.body}</p>
  </div>

  <div class="relative mx-auto mt-8 max-w-[1184px] xl:mt-7 xl:aspect-[1184/512]">
    <img
      src="/images/solutions/cube-composite.webp"
      alt={t.transform.imageAlt}
      width="1187"
      height="883"
      loading="lazy"
      class="cube mx-auto w-full max-w-[420px] ltr:-scale-x-100 xl:absolute xl:max-w-none"
      style={`--x:${pct(415 - 87, STAGE_W)};--y:${pct(1741 - 1676, STAGE_H)};--w:${pct(593, STAGE_W)}`}
    />

    <ul class="mt-6 grid gap-x-5 gap-y-10 pt-6 sm:grid-cols-2 xl:mt-0 xl:block xl:pt-0">
      {
        transformCards.map((card) => (
          <li
            class="tcard glass rounded-xl border-white bg-white/33 p-3 backdrop-blur-[13px] xl:absolute xl:p-[15px]"
            style={`--x:${pct(card.x, STAGE_W)};--y:${pct(card.y, STAGE_H)};--w:${pct(card.w, STAGE_W)}`}
          >
            <div class="flex min-h-[105px] items-start gap-4 rounded-[8.6px] border border-stroke-strong bg-white px-5 py-4 shadow-glow">
              <img
                src={card.icon}
                alt=""
                width="66"
                height={card.iconH}
                loading="lazy"
                class="w-[66px] shrink-0"
                style={`height:${card.iconH}px;margin-top:${card.iconTop - 16}px`}
              />
              <div class="min-w-0 pt-1">
                <h3 class="text-[14px] font-bold leading-[22.6px] text-ink">{t.transform.items[card.key].title}</h3>
                <p
                  class:list={[
                    'mt-1 text-[12.7px] font-medium leading-5',
                    'accent' in card && card.accent ? 'text-primary' : 'text-muted',
                  ]}
                >
                  {t.transform.items[card.key].text}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  @media (min-width: 1280px) {
    .tcard,
    .cube {
      left: var(--x);
      top: var(--y);
      width: var(--w);
    }
    :global([dir='ltr']) .tcard,
    :global([dir='ltr']) .cube {
      left: calc(100% - var(--x) - var(--w));
    }
  }
</style>
