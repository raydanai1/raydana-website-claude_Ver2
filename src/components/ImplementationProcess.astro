---
import { processSteps } from '../data/home';
import { localizeDigits, type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Desktop stage = Figma section-farayand (origin 118,6290), 1255×760.
const W = 1255;
const H = 760;
const px = (v: number) => `${((v / W) * 100).toFixed(3)}%`;
const py = (v: number) => `${((v / H) * 100).toFixed(3)}%`;
const num = (n: number) => localizeDigits(String(n).padStart(2, '0'), locale);
---

<section class="bg-tint pb-16 pt-24 lg:-mt-6 lg:pb-[40px] lg:pt-[106px]" aria-labelledby="process-title">
  <div class="container-x">
    <h2 id="process-title" class="section-title text-center" dir="auto">{t.process.title}</h2>

    <!-- Desktop: serpentine track (Figma 2:27956) with positioned steps -->
    <div class="process-stage relative mx-auto mt-6 hidden aspect-[1255/760] max-w-[1255px] lg:block">
      <img
        src="/images/process/track.webp"
        alt=""
        width="2366"
        height="1047"
        loading="lazy"
        class="absolute mix-blend-darken"
        style={`left:0;top:${py(127.75)};width:${px(1182.86)}`}
      />

      <!-- Start circle -->
      <div class="absolute flex items-center justify-center" style={`left:${px(999)};top:${py(21)};width:${px(256.3)};aspect-ratio:1`}>
        <img src="/images/process/start.webp" alt="" width="513" height="513" class="absolute inset-0 size-full mix-blend-darken" />
        <div class="relative w-[60%] text-center text-white">
          <h3 class="text-title-3 font-bold">{t.process.start.title}</h3>
          <p class="mt-1 text-[13px] font-bold leading-6">{t.process.start.text}</p>
        </div>
      </div>

      <!-- End circle -->
      <div class="absolute flex items-center justify-center" style={`left:${px(19.4)};top:${py(552)};width:${px(149)};aspect-ratio:1`}>
        <img src="/images/process/end.webp" alt="" width="298" height="298" class="absolute inset-0 size-full mix-blend-darken" />
        <p class="relative text-title-3 font-bold text-white">{t.process.end}</p>
      </div>

      <ol>
        {
          processSteps.map((s) => (
            <li>
              <img
                src={`/images/process/dot-${String(s.n).padStart(2, '0')}.svg`}
                alt=""
                class="absolute size-[38px] -translate-x-1/2 -translate-y-1/2"
                style={`left:${px(s.dot[0])};top:${py(s.dot[1])}`}
              />
              {s.n === 3 && (
                <img
                  src="/images/process/dot-03-inner.svg"
                  alt=""
                  class="absolute size-[18.9px] -translate-x-1/2 -translate-y-1/2"
                  style={`left:${px(s.dot[0] - 0.05)};top:${py(s.dot[1] - 0.5)}`}
                />
              )}
              <span
                class="badge absolute flex size-[75px] -translate-x-1/2 -translate-y-1/2 items-center justify-center"
                style={`left:${px(s.badge[0])};top:${py(s.badge[1])}`}
              >
                <img src="/images/process/badge.svg" alt="" class="absolute inset-[-2.85%_-5.69%_-8.54%_-5.69%] h-[111.4%] w-[111.4%] max-w-none" />
                <span class="relative text-[26px] font-bold text-primary">{num(s.n)}</span>
              </span>
              <span
                class="absolute w-[260px] -translate-x-1/2 -translate-y-1/2 text-center text-15 font-bold leading-8 text-body"
                style={`left:${px(s.label[0])};top:${py(s.label[1])}`}
              >
                <span class="block">{t.process.steps[s.key].title}</span>
                <span class="block" dir="ltr">{t.process.steps[s.key].sub}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Mobile/tablet: vertical timeline -->
    <ol class="relative mx-auto mt-10 max-w-[560px] lg:hidden">
      <li class="relative pb-8 ps-20">
        <span class="absolute start-0 top-0 flex size-14 items-center justify-center rounded-full bg-gradient-to-br from-[#a29cff] to-[#7b74f0] shadow-[0_0_0_6px_#fff,0_8px_20px_rgba(98,90,220,0.3)]">
          <img src="/images/header/home.svg" alt="" width="22" height="22" class="brightness-0 invert" />
        </span>
        <h3 class="text-[17px] font-bold text-[#7b74f0]">{t.process.start.title}</h3>
        <p class="mt-1 text-[13px] leading-6 text-body">{t.process.start.text}</p>
      </li>
      {
        processSteps.map((s) => (
          <li class="relative pb-7 ps-20">
            <span class="absolute start-0 top-0 flex size-14 items-center justify-center rounded-full bg-white text-[20px] font-bold text-primary shadow-[0_6px_18px_rgba(98,120,190,0.18)]">
              {num(s.n)}
            </span>
            <h3 class="pt-1.5 text-15 font-bold leading-7 text-ink">{t.process.steps[s.key].title}</h3>
            <p class="text-[13px] font-medium text-muted rtl:text-right" dir="ltr">{t.process.steps[s.key].sub}</p>
          </li>
        ))
      }
      <li class="relative ps-20">
        <span class="absolute start-0 top-0 flex size-14 items-center justify-center rounded-full bg-gradient-to-br from-[#a29cff] to-[#7b74f0] shadow-[0_0_0_6px_#fff,0_8px_20px_rgba(98,90,220,0.3)]">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </span>
        <h3 class="pt-3.5 text-[17px] font-bold text-[#7b74f0]">{t.process.end}</h3>
      </li>
      <span class="timeline-line absolute bottom-6 start-7 top-6 -z-0 w-[3px] -translate-x-1/2 rounded-full rtl:translate-x-1/2" aria-hidden="true"></span>
    </ol>
  </div>
</section>

<style>
  .timeline-line {
    background: linear-gradient(#fbd34d, #f59e0b, #ec4899, #c084fc, #8b5cf6, #3b82f6, #22d3ee, #34d399);
    z-index: -1;
  }
  ol li {
    z-index: 1;
  }
  /* The serpentine track is drawn for right-to-left reading; mirror the whole stage for LTR,
     then un-mirror its text and badges so they stay readable. */
  :global([dir='ltr']) .process-stage {
    transform: scaleX(-1);
  }
  :global([dir='ltr']) .process-stage h3,
  :global([dir='ltr']) .process-stage p,
  :global([dir='ltr']) .process-stage .badge > span,
  :global([dir='ltr']) .process-stage li > span:last-child {
    transform: scaleX(-1);
  }
</style>
