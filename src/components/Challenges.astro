---
import { challenges } from '../data/home';
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Stage size of the Figma "carts" group; chips are placed by their centre point.
const STAGE_W = 1421;
const STAGE_H = 360;

const iconFor = (icon: string) =>
  icon === 'c19'
    ? { oval: '/images/challenges/c19-oval.svg', x: '/images/challenges/c19-x.svg' }
    : icon === 'c02'
      ? { oval: '/images/challenges/c02-oval.svg', x: '/images/challenges/c02-x.svg' }
      : { src: `/images/challenges/${icon}.svg` };
---

<section class="mt-16 lg:mt-[85px]" aria-labelledby="challenges-title">
  <div class="container-x text-center">
    <h2 id="challenges-title" class="section-title">{t.challenges.title}</h2>
    <p class="section-lead mx-auto mt-2 max-w-[784px]">{t.challenges.lead}</p>
  </div>

  <!-- Chips: scattered stage on wide screens, wrapped tags below 1280px. -->
  <div class="relative mx-auto mt-8 max-w-[1421px] px-4 sm:px-6 xl:mt-10 xl:aspect-[1421/360] xl:px-0">
    <ul class="flex flex-wrap justify-center gap-2 sm:gap-3 xl:block">
      {
        challenges.map((c) => {
          const icon = iconFor(c.icon);
          return (
            <li
              class="chip flex h-11 items-center justify-between gap-2 rounded-xl border-[0.4px] border-neutral-200 bg-white ps-3 pe-2 shadow-chip sm:h-[56px] sm:gap-3 sm:rounded-2xl sm:ps-4 xl:absolute xl:h-[69px] xl:ps-6 xl:pe-3"
              style={`--x:${((c.x / STAGE_W) * 100).toFixed(2)}%;--y:${((c.y / STAGE_H) * 100).toFixed(2)}%;--w:${c.w}px;--r:${c.rotate}deg`}
            >
              <span class="text-[12.5px] leading-5 text-ink sm:text-[14px] sm:leading-6 xl:text-15 xl:leading-8">{t.challenges.items[c.key]}</span>
              {'src' in icon ? (
                <img src={icon.src} alt="" width="35" height="35" class="size-6 shrink-0 sm:size-[30px] xl:size-[35px]" />
              ) : (
                <span class="relative size-6 shrink-0 sm:size-[30px] xl:size-[35px]">
                  <img src={icon.oval} alt="" class="absolute inset-0 size-full" />
                  <img src={icon.x} alt="" class="absolute inset-[30%] size-[40%]" />
                </span>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>

  <p
    class="mx-4 mt-8 flex min-h-[64px] max-w-[681px] sm:mx-auto items-center justify-center rounded-[47px] bg-gradient-to-l from-[#0e4fa0] to-[#051d3a] px-6 py-4 text-center text-[15px] font-bold leading-7 text-light shadow-chip relative z-10 xl:-mt-1 xl:min-h-[77px] xl:text-title-3"
  >
    {t.challenges.slogan}
  </p>
</section>

<style>
  @media (min-width: 1280px) {
    .chip {
      inset-inline-start: auto;
      left: var(--x);
      top: var(--y);
      width: max-content;
      min-width: min(var(--w), 260px);
      white-space: nowrap;
      transform: translate(-50%, -50%) rotate(var(--r));
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .chip:hover {
      transform: translate(-50%, -50%) rotate(0deg) scale(1.04);
      z-index: 2;
    }
    /* Mirror the scatter for left-to-right reading. */
    /* English labels are longer, so keep chips clear of the stage edges. */
    :global([dir='ltr']) .chip {
      left: clamp(175px, calc(100% - var(--x)), calc(100% - 175px));
      font-size: 14px;
      transform: translate(-50%, -50%) rotate(calc(var(--r) * -1));
    }
    :global([dir='ltr']) .chip:hover {
      transform: translate(-50%, -50%) rotate(0deg) scale(1.04);
    }
  }
</style>
