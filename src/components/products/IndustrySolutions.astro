---
import { productImages, productIndustries } from '../../data/products';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).products.industries;
---

<!-- Figma 2:5415 (soft gradient), 2:9050 (title), 94:1170 / 94:1171 (6 industry cards). -->
<section class="relative isolate overflow-hidden" aria-labelledby="products-industries-title">
  <img
    src={productImages.industriesBg}
    alt=""
    width="870"
    height="388"
    loading="lazy"
    class="absolute inset-x-0 top-0 -z-10 hidden h-[637px] w-full object-cover opacity-90 lg:block"
  />

  <div class="container-x pb-14 pt-12 lg:pb-[119px] lg:pt-[96px]">
    <!-- Figma ver4 2:9051: "Cyber ERP" over the localized heading, both lines Bold 24px / normal line height, centred. -->
    <h2 id="products-industries-title" class="text-center text-[20px] font-bold leading-normal text-title lg:text-title-2">
      <span class="block" dir="ltr">{t.brand}</span>
      <span class="block">{t.title}</span>
    </h2>

    <!-- Figma ver4: three equal 422.67px columns (1316 total), 24px column gap, 40px row gap. -->
    <!-- Cards are not links: the industry solution pages are not built. -->
    <ul class="mx-auto mt-6 grid max-w-[1316px] grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-[35px] lg:grid-cols-3 lg:gap-x-6 lg:gap-y-10">
      {
        productIndustries.map((item) => (
            <li>
              <div class="industry-card flex h-full flex-col items-start gap-[11px] rounded-3xl border border-stroke bg-[#fafafa] p-5 sm:p-6 lg:min-h-[325.5px]">
                <img src={item.icon} alt="" width="78" height="78" loading="lazy" class="size-[78px]" />
                <!-- Text block sits at the bottom of a 132px area (Figma), so cards with shorter text line up. -->
                <span class="flex w-full flex-col justify-end gap-[5px] sm:min-h-[132px]">
                  <span class="block text-15 font-bold leading-8 text-title">{t.kicker}</span>
                  <span class="block text-title-3 font-bold leading-normal text-title">{t.items[item.key]}</span>
                  <span class="block text-[14px] leading-6 text-muted">{t.descriptions[item.key as keyof typeof t.descriptions]}</span>
                </span>
                <span class="icon-btn" aria-hidden="true">
                  <img src={productImages.cardArrow} alt="" width="18" height="18" class="dir-icon-rev size-[18px]" />
                </span>
              </div>
            </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Figma "cart-industrial cattegory" effect: drop shadow 0 14px 10px #EEF0FF. */
  .industry-card {
    filter: drop-shadow(0 14px 10px #eef0ff);
  }
</style>
