---
import { breadcrumbList } from '../../seo';
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import ProductsHero from './ProductsHero.astro';
import ModulesGrid from './ModulesGrid.astro';
import IndustrySolutions from './IndustrySolutions.astro';
import ComplementaryProducts from './ComplementaryProducts.astro';
import { homePath, type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
// Both hero buttons lead to the same demo section as the homepage CTA.
const ctaHref = `${homePath(locale)}#demo`;
---

<Layout
  locale={locale}
  page="products"
  title={t.products.meta.title}
  description={t.products.meta.description}
  jsonLd={[breadcrumbList(locale, [[t.nav.products, 'products']])]}
>
  <Header locale={locale} page="products" />
  <main id="main">
    <ProductsHero locale={locale} ctaHref={ctaHref} />
    <ModulesGrid locale={locale} />
    <IndustrySolutions locale={locale} />
    <ComplementaryProducts locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
