---
import { tools } from '../data/home';
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="relative isolate overflow-hidden pb-12 pt-12 lg:pb-[74px] lg:pt-[61px]" aria-labelledby="tools-title">
  <img
    src="/images/tools/bg-gradient.webp"
    alt=""
    width="870"
    height="388"
    loading="lazy"
    class="absolute inset-x-0 -top-[22%] -z-10 h-full w-full object-cover opacity-90"
  />

  <div class="container-x">
    <div class="mx-auto max-w-[1048px] text-center">
      <h2 id="tools-title" class="section-title" dir="auto">{t.tools.title}</h2>
      <p class="section-lead mt-2">{t.tools.lead}</p>
      <p class="mt-2 text-[14px] leading-8 text-body lg:text-15">{t.tools.body}</p>
    </div>

    <div class="mt-8 flex flex-col items-center gap-8 lg:mt-14 lg:flex-row lg:items-start lg:justify-between lg:gap-10">
      <ul class="grid w-full max-w-[700px] grid-cols-1 gap-3 sm:grid-cols-2 lg:order-1 lg:gap-x-3 lg:gap-y-3">
        {
          tools.map((tool) => (
            <li class="glass rounded-[17px] bg-white/16 p-3 lg:h-[120px] lg:py-[14px]">
              <a
                href="#contact"
                class="group flex h-full min-h-[91px] items-center gap-3 rounded-[10px] bg-white px-3 shadow-[0_6px_13px_rgba(182,201,205,0.28)] transition hover:shadow-header"
              >
                <span class="relative h-[79px] w-[54px] shrink-0">
                  <img src={tool.icon} alt="" width="54" height="79" class="absolute inset-0 size-full" />
                  <span
                    class:list={[
                      'absolute inset-0 flex items-center justify-center font-bold text-primary-dark',
                      'small' in tool && tool.small ? 'text-[13px]' : 'text-[20px]',
                    ]}
                    dir="ltr"
                  >
                    {tool.badge}
                  </span>
                </span>
                <span class="flex-1 text-[15px] font-bold leading-8 text-title">{t.tools.items[tool.key]}</span>
                <span class="icon-btn group-hover:bg-primary/10" aria-hidden="true">
                  <img src="/images/tools/arrow-small.svg" alt="" width="18" height="18" class="dir-icon-rev" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <img
        src="/images/tools/ecosystem.webp"
        alt={t.tools.imageAlt}
        width="796"
        height="800"
        loading="lazy"
        class="w-full max-w-[340px] mix-blend-darken lg:order-2 lg:-mt-2 lg:w-[398px] lg:max-w-none"
      />
    </div>
  </div>
</section>
