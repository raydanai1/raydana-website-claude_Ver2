---
import { trustedLogos } from '../data/home';
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="container-x pt-14 lg:pt-[58px]" aria-labelledby="customers-title">
  <h2 id="customers-title" class="section-title relative z-10 text-center">{t.customers.title}</h2>

  <!-- Desktop: the logo wall exactly as composed in Figma (section-logo moshtary). -->
  <img
    src="/images/customers/logo-wall.webp"
    alt={t.customers.wallAlt}
    width="2400"
    height="1159"
    loading="lazy"
    class="mx-auto -mt-4 hidden w-full max-w-[1382px] md:block"
  />

  <!-- Mobile: tidy logo grid. -->
  <ul class="mt-6 grid grid-cols-3 gap-3 md:hidden">
    {
      trustedLogos.slice(0, 9).map((logo) => (
        <li class="flex aspect-[133/150] items-center justify-center rounded-[14px] border-[0.6px] border-stroke bg-[#fafafa] p-2 shadow-industry">
          <img src={logo.src} alt={t.logos[logo.key]} width="96" height="96" loading="lazy" class="size-full max-h-[90px] object-contain" />
        </li>
      ))
    }
  </ul>
</section>
