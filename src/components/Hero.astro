---
import Button from './ui/Button.astro';
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="relative -mt-[84px] overflow-hidden lg:-mt-[118px]" aria-labelledby="hero-title">
  <!-- Background: cube illustration + fade toward the text side (Figma 2076:3931, 2:19789). -->
  <div class="absolute inset-x-0 top-0 hidden h-[614px] lg:block" aria-hidden="true">
    <img
      src="/images/hero/hero-bg.webp"
      alt=""
      width="1024"
      height="543"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover ltr:-scale-x-100"
    />
    <div
      class="absolute inset-y-0 start-0 w-1/2 rtl:bg-gradient-to-l ltr:bg-gradient-to-r from-light from-[39%] to-light/0"
    >
    </div>
  </div>

  <div class="container-x relative pt-[120px] lg:flex lg:min-h-[614px] lg:items-start lg:pt-[184px]">
    <div class="max-w-[693px] lg:ms-0">
      <h1 id="hero-title" class="text-[24px] font-bold leading-snug text-ink sm:text-[28px] lg:text-title-1">
        {t.hero.title}
      </h1>
      <p class="mt-3 text-[18px] font-bold leading-snug text-primary sm:text-[20px] lg:mt-4 lg:text-title-2">
        {t.hero.subtitle}
      </p>
      <p class="mt-4 max-w-[633px] text-[14px] font-bold leading-8 text-body lg:mt-5 lg:text-15">
        {t.hero.body}
      </p>
      <div class="mt-6 flex flex-wrap gap-4 lg:mt-8">
        <Button href="#contact">{t.cta.consult}</Button>
        <Button href="#demo" variant="outline">{t.cta.demo}</Button>
      </div>
    </div>
  </div>

  <!-- Mobile/tablet: show the illustration below the copy. -->
  <div class="relative mt-6 h-[240px] overflow-hidden sm:h-[320px] lg:hidden" aria-hidden="true">
    <img
      src="/images/hero/hero-bg.webp"
      alt=""
      width="1024"
      height="543"
      class="absolute inset-0 size-full object-cover object-[12%_50%] ltr:-scale-x-100 ltr:object-[88%_50%]"
    />
  </div>
</section>
