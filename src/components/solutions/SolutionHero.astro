---
import Button from '../ui/Button.astro';
import { oilGasImages } from '../../data/solutions/oil-gas';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
  ctaHref: string;
}
const { locale, ctaHref } = Astro.props;
const t = useTranslations(locale).solutionOilGas.hero;
---

<!-- Figma 2:1046 (background), 99:1008 (text), 2:1049 (buttons), 2078:3935 (hexagon picture). -->
<section class="relative -mt-[84px] overflow-hidden bg-light-3 lg:-mt-[118px]" aria-labelledby="solution-hero-title">
  <div class="container-x relative pb-10 pt-[112px] lg:h-[581px] lg:pb-0 lg:pt-[154px]">
    <div class="lg:max-w-[calc(100%-470px)] xl:max-w-[640px] xl:pe-[27px]">
      <h1 id="solution-hero-title" class="text-[22px] font-bold leading-normal text-title lg:text-title-2">
        <span class="block">{t.kicker}</span>
        <span class="block">{t.title}</span>
      </h1>
      <p class="mt-2 text-[16px] font-bold leading-normal text-primary lg:mt-[9px] lg:text-title-3">{t.lead}</p>
      <p class="mt-3 text-[14px] leading-8 text-body lg:mt-[11px] lg:text-15 rtl:lg:text-justify">{t.body}</p>
      <div class="mt-7 flex flex-wrap gap-[10px] lg:mt-[30px] lg:gap-[15px]">
        <Button href={ctaHref}>{t.consult}</Button>
        <Button href={ctaHref} variant="outline">{t.demo}</Button>
      </div>
    </div>

    <!-- Hexagon cluster with the refinery render (Figma «LONEZANBORI 1», 663×456). -->
    <div
      class="relative mx-auto mt-6 aspect-[662.961/455.789] w-full max-w-[480px] sm:max-w-[560px] lg:absolute lg:end-0 lg:top-[150px] lg:mt-0 lg:w-[460px] xl:end-[-46px] xl:top-[124px] xl:w-[662.961px] xl:max-w-none"
      aria-hidden="true"
    >
      <img
        src={oilGasImages.heroHexShadow}
        alt=""
        width="582.213"
        height="420.586"
        class="absolute left-[11%] top-[-1.42%] h-[92.28%] w-[87.82%] opacity-20 mix-blend-multiply"
      />
      <img src={oilGasImages.heroHexes} alt="" width="610" height="316.581" class="absolute left-[6.79%] top-[7.24%] h-[69.46%] w-[92.01%]" />
      <img
        src={oilGasImages.heroRefinery}
        alt=""
        width="567"
        height="322"
        fetchpriority="high"
        class="absolute left-[30.59%] top-[23.27%] h-[35.23%] w-[42.75%] skew-x-2"
      />
    </div>
  </div>
</section>
