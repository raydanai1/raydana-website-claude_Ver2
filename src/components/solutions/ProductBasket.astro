---
import { basketModules, chipPages, oilGasImages } from '../../data/solutions/oil-gas';
import { modulePage } from '../../data/modules';
import { localizeDigits, pagePath, type Page, type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).solutionOilGas.basket;
---

<!-- Figma 2:1047 (photo) + 2:1048 (gradient), 2:4737 (title), 6 cards 2:4908 … 2:5115. -->
<section class="relative isolate overflow-hidden bg-[#193152]" aria-labelledby="solution-basket-title">
  <img src={oilGasImages.basketPhoto} alt="" width="740" height="592" loading="lazy" class="absolute inset-0 -z-10 size-full object-cover" />
  <div class="basket-shade absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-x pb-14 pt-12 lg:pb-[187px] lg:pt-[78px]">
    <h2 id="solution-basket-title" class="text-center text-[20px] font-bold leading-normal text-[#fafafa] md:text-title-2">{t.title}</h2>

    <!-- Two 634px columns, 24px apart, as in Figma; one column below 1024px. -->
    <ul class="mx-auto mt-8 grid max-w-[1292px] grid-cols-1 gap-5 lg:mt-[50px] lg:grid-cols-2 lg:gap-x-6 lg:gap-y-[25px]">
      {
        basketModules.map((item) => (
          <li class="basket-card group relative rounded-2xl border-[0.856px] border-stroke bg-[#fafafa] pb-6 transition duration-200 hover:-translate-y-1 lg:min-h-[315px]">
            <div class="flex items-start gap-[7px] pe-14 ps-[14px] pt-[17px]">
              <img src={item.icon} alt="" width="68.0947" height="68.0947" loading="lazy" class="size-[56px] shrink-0 sm:size-[68.095px]" />
              <div class="pt-[7px] sm:pt-[9px]">
                <h3 class="text-[16px] font-bold leading-[27px] text-title sm:text-title-3">
                  <!-- The whole card links to the module page; chips naming a subsystem sit above with their own link. -->
                  <a href={pagePath(modulePage(item.module), locale)} class="after:absolute after:inset-0 after:rounded-2xl">{t.modules[item.key]}</a>
                </h3>
                <p class="text-small leading-8 text-muted">{localizeDigits(t.includes.replace('{n}', String(item.count)), locale)}</p>
              </div>
            </div>
            <span class="icon-btn absolute end-[17px] top-[21px] transition-colors group-hover:bg-primary/10" aria-hidden="true">
              <img src={oilGasImages.cardArrow} alt="" width="18" height="18" class="dir-icon-rev size-[18px]" />
            </span>
            <ul class="mt-4 flex flex-wrap gap-x-[10px] gap-y-3 pe-5 ps-4 sm:mt-[17px] sm:gap-y-[18px] sm:pe-[34px] sm:ps-[23px]">
              {item.chips.map((chip) => {
                const page = chipPages[chip] as Page | undefined;
                return page ? (
                  <li class="relative z-10 flex">
                    <a href={pagePath(page, locale)} class="basket-chip flex h-10 items-center rounded-[49px] bg-light-3 px-3 text-small leading-8 whitespace-nowrap text-body">
                      {t.chips[chip]}
                    </a>
                  </li>
                ) : (
                  <li class="basket-chip flex h-10 items-center rounded-[49px] bg-light-3 px-3 text-small leading-8 whitespace-nowrap text-body">
                    {t.chips[chip]}
                  </li>
                );
              })}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Figma 2:1048: dark blue gradient at 86% over the photo. */
  .basket-shade {
    background-image: linear-gradient(244.47deg, rgba(48, 80, 101, 0.86) 6.79%, rgba(25, 49, 82, 0.86) 93.94%);
  }
  .basket-card {
    box-shadow: 0 8px 16px rgba(215, 219, 240, 0.5);
  }
  .basket-chip {
    transition: background-color 0.2s;
  }
  /* Figma «hover» chip: pale yellow. */
  .basket-chip:hover {
    background-color: #fff7d5;
  }
</style>
