---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import SolutionHero from './SolutionHero.astro';
import ProductBasket from './ProductBasket.astro';
import SolutionBenefits from './SolutionBenefits.astro';
import CloudFeatures from '../cloud/CloudFeatures.astro';
import DemoRequestForm from '../cloud/DemoRequestForm.astro';
import Faq from '../cloud/Faq.astro';
import { oilGasImages, oilGasTabs } from '../../data/solutions/oil-gas';
import { cloudImages } from '../../data/cloud';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).solutionOilGas;
const tabs = oilGasTabs.map((key) => ({ key, label: t.features.tabs[key].label, items: t.features.tabs[key].items }));
---

<Layout locale={locale} page="oilGas" title={t.meta.title} description={t.meta.description}>
  <Header locale={locale} page="oilGas" />
  <main id="main">
    <SolutionHero locale={locale} ctaHref="#demo" />
    <ProductBasket locale={locale} />
    <SolutionBenefits locale={locale} />
    <!-- Figma 2:5158 (title + tabs) and 2:5183 (two equal columns, same dot in both). -->
    <CloudFeatures
      locale={locale}
      id="oil-gas"
      title={t.features.title}
      tabs={tabs}
      dotEnd={cloudImages.dotStart}
      columns="md:grid-cols-2"
      listWidth="max-w-[1311px]"
      listGap="lg:mt-[29px]"
      spacing="pb-14 pt-12 lg:pb-[82px] lg:pt-[71px]"
      titleClass="text-ink"
    />
    <!-- Figma 2:4742: refinery photo under a blue radial gradient at 60%. -->
    <DemoRequestForm
      locale={locale}
      photo={oilGasImages.demoPhoto}
      hex={oilGasImages.demoHex}
      hexIcon={oilGasImages.demoHexIcon}
      overlay="demo-shade-oil-gas"
      height="lg:min-h-[616px]"
    />
    <!-- Figma 2027:9512. -->
    <Faq locale={locale} title={t.faq.title} items={t.faq.items} spacing="pb-14 pt-14 lg:pb-[234px] lg:pt-[93px]" />
  </main>
  <Footer locale={locale} />
</Layout>

<style is:global>
  .demo-shade-oil-gas {
    opacity: 0.6;
    background-image: radial-gradient(56.45% 56.49% at 49.17% 29.53%, #02699c 0%, #064c6f 25.24%, #0a3042 50.48%, #002035 100%);
  }
</style>
