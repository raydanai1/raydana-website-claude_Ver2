---
import { benefitRows, oilGasImages } from '../../data/solutions/oil-gas';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale).solutionOilGas.benefits;
const chips = benefitRows.flatMap((row) => row.chips);
---

<!-- Figma 2:4793 (band, title, 12 chips) and 102:10996 (hexagon photo). -->
<section class="benefits-band overflow-hidden pb-12 pt-10 xl:h-[565px] lg:pt-[38px] xl:pb-[36px]" aria-labelledby="solution-benefits-title">
  <div class="container-x">
    <h2 id="solution-benefits-title" class="text-center text-[20px] font-bold leading-normal text-ink md:text-title-2">{t.title}</h2>

    <div class="mt-8 flex flex-col items-center gap-8 lg:mt-[34px] xl:flex-row-reverse xl:items-start xl:justify-between xl:gap-6 xl:pe-[28px] xl:ps-[31px]">
      <!-- Hexagon photo: pale hexagon behind, white hexagon in front, refinery clipped to the inner hexagon. -->
      <div class="relative aspect-[410/377] w-full max-w-[280px] shrink-0 sm:max-w-[340px] xl:mt-[-1px] xl:w-[410px] xl:max-w-none" aria-hidden="true">
        <img src={oilGasImages.benefitsHexBack} alt="" width="313.501" height="359.555" loading="lazy" class="absolute left-[5.915%] top-[0.326%] h-[95.37%] w-[76.46%]" />
        <img src={oilGasImages.benefitsHexFront} alt="" width="340.305" height="381.224" loading="lazy" class="absolute left-[16.79%] top-[-1.228%] h-[101.12%] w-[83.01%]" />
        <div class="benefits-mask absolute left-[20.69%] top-[0.324%] h-[93.78%] w-[75.2%] overflow-hidden" style={`--mask:url(${oilGasImages.benefitsHexMask})`}>
          <img src={oilGasImages.benefitsFactory} alt="" width="740" height="557" loading="lazy" class="absolute left-[-26.22%] top-[9.27%] h-[103.86%] w-[148.89%] max-w-none object-cover" />
        </div>
      </div>

      <!-- Desktop: Figma's five staggered rows. Below 1280px: a plain list (2 columns from 640px). -->
      <div class="hidden w-[818px] xl:block">
        {
          benefitRows.map((row) => (
            <ul class="flex flex-wrap" style={`margin-top:${row.top}px`}>
              {row.chips.map((chip) => (
                <li
                  class="benefit-glass p-[10px]"
                  style={`margin-inline-start:${chip.offset}px;width:${chip.width}px;border-radius:${chip.radius}px;--glass:${chip.glass}`}
                >
                  <span class="benefit-chip flex h-[55px] items-center gap-[10px] pe-3 ps-[13px]" style={`border-radius:${chip.innerRadius}px`}>
                    <img src={chip.check} alt="" width={chip.size} height={chip.size} loading="lazy" class="shrink-0" style={`width:${chip.size}px;height:${chip.size}px`} />
                    <span class:list={['text-[14px] text-ink', locale === 'fa' ? 'whitespace-nowrap leading-6' : 'leading-5']}>{t.items[chip.key]}</span>
                  </span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>

      <ul class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2 xl:hidden">
        {
          chips.map((chip) => (
            <li class="benefit-glass p-2" style={`border-radius:${chip.radius}px;--glass:${chip.glass}`}>
              <span class="benefit-chip flex min-h-[55px] items-center gap-[10px] px-[13px] py-2" style={`border-radius:${chip.innerRadius}px`}>
                <img src={chip.check} alt="" width={chip.size} height={chip.size} loading="lazy" class="size-[26px] shrink-0" />
                <span class="text-[14px] leading-6 text-ink">{t.items[chip.key]}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Figma 2:4795: soft blue-grey radial gradient. */
  .benefits-band {
    background-color: #e1eaee;
    background-image: radial-gradient(56.4% 56.5% at 49.2% 29.5%, #e1eaee 0%, #cee1ea 50.48%, #e1eaee 100%);
  }
  /* Glass frame: white at 22% (no edge) or 44% (white edge), blurred. */
  .benefit-glass {
    border: 1px solid rgba(255, 255, 255, calc((var(--glass) - 0.22) / 0.22));
    background-color: rgba(255, 255, 255, var(--glass));
    backdrop-filter: blur(15.5px);
  }
  .benefit-chip {
    border: 1px solid #7c93e3;
    background-color: #fff;
    box-shadow: 0 0 40px rgba(190, 190, 223, 0.74);
  }
  .benefits-mask {
    -webkit-mask: var(--mask) center / 100% 100% no-repeat;
    mask: var(--mask) center / 100% 100% no-repeat;
  }
</style>
