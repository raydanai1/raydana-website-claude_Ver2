---
import Button from './ui/Button.astro';
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
  /** "dark" = Figma ContactMoshavereHeader (blue buttons), "banner" = Figma banner (violet buttons). */
  variant?: 'dark' | 'banner';
  text: string;
  class?: string;
}
const { locale, variant = 'dark', text, class: className = '' } = Astro.props;
const t = useTranslations(locale);
const isBanner = variant === 'banner';
---

<div class:list={['container-x relative z-10', className]}>
  <div
    class:list={[
      'flex flex-col items-center justify-between gap-4 bg-gradient-to-r from-[#0e0e1a] to-[#12126b] px-6 py-5 text-center lg:flex-row lg:text-start',
      isBanner ? 'rounded-[40px] shadow-banner lg:min-h-[95px] lg:rounded-[74px] lg:ps-9 lg:pe-5' : 'rounded-[36px] lg:min-h-[72px] lg:rounded-[42px] lg:py-3 lg:ps-12 lg:pe-[14px]',
    ]}
  >
    <p class="text-[15px] font-bold leading-7 text-light lg:text-title-3">{text}</p>
    <div class="flex flex-wrap justify-center gap-3 lg:flex-nowrap">
      {
        isBanner ? (
          <>
            <Button href="#demo" variant="violet-outline">{t.cta.demo}</Button>
            <Button href="#contact" variant="violet">{t.cta.consult}</Button>
          </>
        ) : (
          <>
            <Button href="#contact" variant="white">{t.cta.consult}</Button>
            <Button href="#demo">{t.cta.demo}</Button>
          </>
        )
      }
    </div>
  </div>
</div>
