---
import '../styles/global.css';
import { localeInfo, pagePath, locales, type Locale, type Page, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
  /** Which page this is; used for the canonical and hreflang links. */
  page?: Page;
  /** Page-specific title and description (defaults to the homepage meta). */
  title?: string;
  description?: string;
  /** Languages this page exists in (for hreflang); defaults to all. */
  available?: readonly Locale[];
  /** Share image (absolute path or URL) and Open Graph type, e.g. for knowledge base articles. */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { locale, page = 'home', available = locales, ogImage = '/images/hero/hero-bg.webp', ogType = 'website' } = Astro.props;
const t = useTranslations(locale);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const { dir, htmlLang, ogLocale } = localeInfo[locale];
const site = Astro.site ?? new URL('https://raydana.com');
const canonical = new URL(pagePath(page, locale), site).href;
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {available.length > 1 && available.map((l) => <link rel="alternate" hreflang={l} href={new URL(pagePath(page, l), site).href} />)}
    {available.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(pagePath(page, available[0]), site).href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b518c" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <link rel="preload" href="/fonts/IRANSansX-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/IRANSansX-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <!-- Vazirmatn is only used if IRANSansX fails to load. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/vazirmatn@33.0.3/Vazirmatn-font-face.css"
      media="print"
      onload="this.media='all'"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow-lg"
      >{t.a11y.skip}</a
    >
    <slot />
  </body>
</html>
